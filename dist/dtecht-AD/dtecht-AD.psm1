#region lib/Compare.ps1
<#
    Run-to-run comparison.
    Every run writes results.json. Passing -Baseline <previous run folder or results.json>
    compares the two runs and reports what changed:

      Added / Removed  - members of privileged groups (direct or nested)
      Changed          - DomainPolicy settings whose value changed
      New / Resolved   - individual findings (one per issue in the Finding text)

    Numbers and dates inside findings are normalised ("Password is 400 days old"
    and "Password is 401 days old" are the same finding). Host-scanner findings
    are only marked Resolved when the host was actually scanned again, so an
    unreachable host doesn't look fixed. The Events scanner is time-windowed and
    is not compared.
#>

$script:ADAuditAdScannerNames = @('DomainPolicy', 'Accounts', 'Groups', 'OSInventory', 'LapsBitLocker', 'AuditPolicy', 'DomainControllers', 'Permissions')
$script:ADAuditNotCompared = @('Events', 'Runner', 'Reachability')

function Read-ADAuditRun {
    param([Parameter(Mandatory)][string]$Path)
    if (Test-Path -LiteralPath $Path -PathType Container) { $Path = Join-Path $Path 'results.json' }
    if (-not (Test-Path -LiteralPath $Path)) { throw "Baseline not found: $Path" }
    $run = Get-Content -LiteralPath $Path -Raw -Encoding UTF8 | ConvertFrom-Json
    if (-not $run.Results) { throw "Baseline has no Results: $Path" }
    # PowerShell 7 turns ISO timestamps into DateTime; keep one readable format
    if ($run.Meta -and $run.Meta.Generated -is [datetime]) { $run.Meta.Generated = $run.Meta.Generated.ToString('yyyy-MM-dd HH:mm') }
    return $run
}

function ConvertTo-ADAuditIssueKey {
    param([string]$Issue)
    $k = $Issue.Trim()
    $k = $k -replace '\d{4}-\d{2}-\d{2}( \d{2}:\d{2}(:\d{2})?)?', '<date>'
    $k = $k -replace '\d+', '#'
    return $k.ToLowerInvariant()
}

function Split-ADAuditFinding {
    param([string]$Finding)
    if (-not $Finding) { return @() }
    # Split on '; ' that is not inside parentheses
    $parts = @(); $depth = 0; $sb = New-Object System.Text.StringBuilder
    for ($i = 0; $i -lt $Finding.Length; $i++) {
        $c = $Finding[$i]
        if ($c -eq '(') { $depth++ } elseif ($c -eq ')' -and $depth -gt 0) { $depth-- }
        if ($c -eq ';' -and $depth -eq 0 -and $i + 1 -lt $Finding.Length -and $Finding[$i + 1] -eq ' ') {
            $parts += $sb.ToString(); [void]$sb.Clear(); $i++; continue
        }
        [void]$sb.Append($c)
    }
    if ($sb.Length) { $parts += $sb.ToString() }
    return @($parts | Where-Object { $_.Trim() })
}

function New-ADAuditChange {
    param([string]$Change, [string]$Severity, [string]$Scanner, [string]$Target, [string]$Detail, [string]$Previous, [string]$Current)
    [pscustomobject][ordered]@{
        Change = $Change; Severity = $Severity; Scanner = $Scanner; Target = $Target; Detail = $Detail; Previous = $Previous; Current = $Current
    }
}

function Test-ADAuditPrivMemberRow { param($r) return ($r.Scanner -eq 'Groups' -and $r.Check -eq 'PrivilegedMember') }

function Get-ADAuditFindingIndex {
    # key (scanner|target|normalised issue) -> first matching row/issue
    param([object[]]$Rows)
    $h = @{}
    foreach ($r in $Rows) {
        if (($r.Scanner -eq 'DomainPolicy') -or (Test-ADAuditPrivMemberRow $r) -or ($r.Severity -in 'OK', 'Error') -or (-not $r.Finding)) { continue }
        foreach ($i in (Get-ADAuditIssue -Row $r)) {
            if ($i.Severity -in 'OK', 'Error') { continue }
            $key = "$($r.Scanner)|$($r.Target)|$(ConvertTo-ADAuditIssueKey $i.Issue)".ToLowerInvariant()
            if (-not $h.ContainsKey($key)) { $h[$key] = [pscustomobject]@{ Row = $r; Issue = $i.Issue; Severity = $i.Severity } }
        }
    }
    return $h
}

function Compare-ADAuditRun {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][AllowEmptyCollection()][object[]]$Previous,
        [Parameter(Mandatory)][AllowEmptyCollection()][object[]]$Current,
        [string[]]$PreviousScanners,
        [string[]]$CurrentScanners
    )

    # Only compare scanners that ran both times
    $both = @($script:ADAuditAdScannerNames + 'Spooler', 'Smb', 'LocalAdmin', 'Share')
    if ($PreviousScanners) { $both = @($both | Where-Object { $_ -in $PreviousScanners }) }
    if ($CurrentScanners) { $both = @($both | Where-Object { $_ -in $CurrentScanners }) }
    $prev = @($Previous | Where-Object { $_.Scanner -in $both })
    $cur = @($Current | Where-Object { $_.Scanner -in $both })

    # --- Privileged group membership ---
    $pPm = @{}; foreach ($r in $prev) { if (Test-ADAuditPrivMemberRow $r) { $pPm["$($r.Group)|$($r.DistinguishedName)".ToLowerInvariant()] = $r } }
    $cPm = @{}; foreach ($r in $cur) { if (Test-ADAuditPrivMemberRow $r) { $cPm["$($r.Group)|$($r.DistinguishedName)".ToLowerInvariant()] = $r } }
    foreach ($k in $cPm.Keys) {
        if (-not $pPm.ContainsKey($k)) {
            $r = $cPm[$k]
            New-ADAuditChange -Change 'Added' -Severity 'High' -Scanner 'Groups' -Target $r.Member -Detail "Now a member of $($r.Group) ($($r.Membership))" -Current $r.DistinguishedName
        }
    }
    foreach ($k in $pPm.Keys) {
        if (-not $cPm.ContainsKey($k)) {
            $r = $pPm[$k]
            New-ADAuditChange -Change 'Removed' -Severity 'Info' -Scanner 'Groups' -Target $r.Member -Detail "No longer a member of $($r.Group)" -Previous $r.DistinguishedName
        }
    }

    # --- Domain policy values ---
    $pDp = @{}; foreach ($r in $prev) { if ($r.Scanner -eq 'DomainPolicy' -and $r.Setting) { $pDp[[string]$r.Setting] = $r } }
    foreach ($r in $cur) {
        if ($r.Scanner -ne 'DomainPolicy' -or -not $r.Setting) { continue }
        $p = $pDp[[string]$r.Setting]
        if ($p -and ([string]$p.Value -ne [string]$r.Value)) {
            $sev = $(if ($r.Severity -and $r.Severity -ne 'OK') { $r.Severity } else { 'Info' })
            New-ADAuditChange -Change 'Changed' -Severity $sev -Scanner 'DomainPolicy' -Target $r.Setting -Detail "$($r.Setting) changed" -Previous ([string]$p.Value) -Current ([string]$r.Value)
        }
    }

    # --- Individual findings ---
    $pF = Get-ADAuditFindingIndex -Rows $prev
    $cF = Get-ADAuditFindingIndex -Rows $cur

    # Which host-scanner targets were actually scanned this time?
    $scannedNow = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    foreach ($r in $cur) { [void]$scannedNow.Add("$($r.Scanner)|$($r.Target)") }

    foreach ($k in $cF.Keys) {
        if (-not $pF.ContainsKey($k)) {
            $x = $cF[$k]
            New-ADAuditChange -Change 'New' -Severity $x.Severity -Scanner $x.Row.Scanner -Target $x.Row.Target -Detail $x.Issue
        }
    }
    foreach ($k in $pF.Keys) {
        if ($cF.ContainsKey($k)) { continue }
        $x = $pF[$k]
        $isAd = $x.Row.Scanner -in $script:ADAuditAdScannerNames
        if (-not $isAd -and -not $scannedNow.Contains("$($x.Row.Scanner)|$($x.Row.Target)")) { continue }
        New-ADAuditChange -Change 'Resolved' -Severity 'Info' -Scanner $x.Row.Scanner -Target $x.Row.Target -Detail $x.Issue
    }
}
#endregion lib/Compare.ps1

#region lib/Remediation.ps1
<#
    Rules: maps each finding (one issue of a result row) to a category, a rule title
    and remediation text, and computes risk scores.

    Scoring (PingCastle-style, lower is better, 0-100 per category):
      each triggered rule counts once, at the highest severity seen for it:
      High = 15, Medium = 8, Low = 3 points; category score is capped at 100.
      Overall score = the worst category. Info/OK/Error rows and the Events
      scanner (activity, not posture) are not scored.
#>

$script:ADAuditCategories = @('Privileged Access', 'Permissions', 'Kerberos & Delegation', 'Passwords & Credentials', 'Host Hardening', 'Monitoring & Audit', 'Stale Objects & Hygiene')
$script:ADAuditScannerCategory = @{
    Accounts = 'Passwords & Credentials'; Groups = 'Privileged Access'; DomainPolicy = 'Passwords & Credentials'; OSInventory = 'Host Hardening'
    LapsBitLocker = 'Passwords & Credentials'; DomainControllers = 'Stale Objects & Hygiene'; AuditPolicy = 'Monitoring & Audit'; Events = 'Recent Changes'
    Spooler = 'Host Hardening'; Smb = 'Host Hardening'; LocalAdmin = 'Host Hardening'; Share = 'Permissions'; Permissions = 'Permissions'
}
$script:ADAuditPoints = @{ High = 15; Medium = 8; Low = 3 }

# First match wins: put specific patterns before general ones.
$script:ADAuditRules = @(
    # --- Permissions ---
    @{ T = 'DCSync rights for non-DC accounts'; C = 'Permissions'; P = 'Can DCSync|one right short of DCSync'; R = 'Remove Replicating Directory Changes / Changes All from the domain root for everyone except DCs and the Entra Connect sync account; treat that account as Tier 0.' }
    @{ T = 'Dangerous rights on Tier-0 objects'; C = 'Permissions'; P = '^Dangerous rights for non-Tier-0'; R = 'Remove the ACE from the object (and from AdminSDHolder if it is set there, or SDProp will put it back). Only Tier-0 groups should be able to change Tier-0 objects.' }
    @{ T = 'Non-Tier-0 owner of Tier-0 object'; C = 'Permissions'; P = '^Non-Tier-0 owner'; R = 'Change the owner to Domain Admins. An owner can always rewrite the ACL.' }
    @{ T = 'Non-admin can edit GPOs'; C = 'Permissions'; P = '^Can edit GPO|^GPO owned by|^Can modify GPO files'; R = 'Remove edit rights from the GPO (GPMC > Delegation) and its SYSVOL folder. Only Tier 0 should edit GPOs that apply to DCs or the whole domain.' }
    @{ T = 'LAPS password readers'; C = 'Permissions'; P = '^Can read LAPS passwords'; R = 'Limit LAPS password read to dedicated admin groups per tier (Set-LapsADReadPasswordPermission / Set-AdmPwdReadPasswordPermission).' }
    @{ T = 'gMSA password readers'; C = 'Permissions'; P = 'gMSA password|password of privileged gMSA'; R = 'Limit PrincipalsAllowedToRetrieveManagedPassword to the servers that run the service.' }
    @{ T = 'Anyone can join computers (MachineAccountQuota)'; C = 'Permissions'; P = 'can join up to'; R = 'Set ms-DS-MachineAccountQuota to 0 and delegate computer joins to a specific group.' }
    @{ T = 'Anonymous AD enumeration'; C = 'Permissions'; P = 'Pre-Windows 2000 Compatible Access'; R = 'Remove Anonymous Logon and Everyone from Pre-Windows 2000 Compatible Access.' }
    @{ T = 'Share readable by scanning account'; C = 'Permissions'; P = 'Share root listable'; R = 'Review share and NTFS permissions; remove Everyone, Authenticated Users and Domain Users where not needed.' }
    # --- Privileged access ---
    @{ T = 'Hidden admin membership (primaryGroupID)'; C = 'Privileged Access'; P = 'Hidden membership|Primary group is privileged|DC primaryGroupID'; R = 'Set primaryGroupID back to 513 (users) / 515 (computers); add explicit membership only if really needed.' }
    @{ T = 'Operator / Schema / Enterprise Admins not empty'; C = 'Privileged Access'; P = 'should normally be empty'; R = 'Empty these groups; add members only temporarily for a specific task.' }
    @{ T = 'Too many admins'; C = 'Privileged Access'; P = '^Too many admins'; R = 'Keep Domain/Enterprise Admins to a few named admin accounts; delegate day-to-day tasks instead.' }
    @{ T = 'Computer account in admin group'; C = 'Privileged Access'; P = 'Computer account in privileged group'; R = 'Remove computer accounts from admin groups; grant only the specific right needed.' }
    @{ T = 'Foreign principal in admin group'; C = 'Privileged Access'; P = 'Foreign \(cross-trust\) principal'; R = 'Remove accounts from other domains/forests from admin groups.' }
    @{ T = 'gMSA in admin group'; C = 'Privileged Access'; P = 'gMSA in privileged group'; R = 'Confirm the service needs Tier-0 rights; otherwise delegate only what it needs.' }
    @{ T = 'Disabled account in admin group'; C = 'Privileged Access'; P = 'Disabled account still in privileged group'; R = 'Remove disabled accounts from admin groups.' }
    @{ T = 'Admins not in Protected Users'; C = 'Privileged Access'; P = 'not in Protected Users'; R = 'Add admin accounts to Protected Users (test first: blocks NTLM, delegation, DES/RC4 and cached logons).' }
    @{ T = "Admins not 'sensitive and cannot be delegated'"; C = 'Privileged Access'; P = 'sensitive and cannot be delegated'; R = "Set 'Account is sensitive and cannot be delegated' on all admin accounts." }
    @{ T = 'SID history'; C = 'Privileged Access'; P = 'sIDHistory|SID history'; R = 'Remove sIDHistory after migration; keep SID filtering enabled on trusts.' }
    @{ T = 'Guest account enabled'; C = 'Privileged Access'; P = 'Built-in Guest .* is enabled'; R = 'Disable the Guest account.' }
    # --- Kerberos & delegation ---
    @{ T = 'AS-REP roastable accounts'; C = 'Kerberos & Delegation'; P = 'pre-auth not required|Require Preauth enabled'; R = "Clear 'Do not require Kerberos preauthentication'. If an app needs it, give the account a long random password." }
    @{ T = 'Unconstrained delegation'; C = 'Kerberos & Delegation'; P = 'nconstrained delegation|Trusted For Delegation enabled'; R = 'Remove unconstrained delegation; use constrained or resource-based delegation, and protect admins (Protected Users / sensitive flag).' }
    @{ T = 'Delegation with protocol transition'; C = 'Kerberos & Delegation'; P = 'protocol transition|Authenticate For Delegation'; R = 'Use Kerberos-only constrained delegation unless protocol transition is really required.' }
    @{ T = 'Constrained / resource-based delegation'; C = 'Kerberos & Delegation'; P = 'Constrained delegation|Delegation set to|delegation target|Resource-based constrained'; R = 'Confirm each delegation is needed. Delegation to services on DCs (ldap/cifs/host) is Tier 0.' }
    @{ T = 'Kerberoastable admin accounts'; C = 'Kerberos & Delegation'; P = 'Privileged account has SPN'; R = 'Remove SPNs from admin accounts; run services as gMSAs.' }
    @{ T = 'Kerberoastable user accounts'; C = 'Kerberos & Delegation'; P = 'has SPN|SPN added on user'; R = 'Move the service to a gMSA, or use a 25+ character random password and AES only.' }
    @{ T = 'DES-only Kerberos'; C = 'Kerberos & Delegation'; P = 'DES-only|Use DES Key Only'; R = "Clear 'Use only Kerberos DES encryption types'; use AES." }
    @{ T = 'Old krbtgt password'; C = 'Kerberos & Delegation'; P = 'krbtgt password'; R = 'Reset the krbtgt password twice, waiting for replication in between (e.g. Microsoft New-KrbtgtKeys.ps1).' }
    # --- Passwords & credentials ---
    @{ T = 'Cleartext password attributes'; C = 'Passwords & Credentials'; P = 'Cleartext password stored'; R = 'Clear the attribute and change the password; these attributes are readable by most users.' }
    @{ T = 'Password in description'; C = 'Passwords & Credentials'; P = 'Description may contain a password'; R = "Remove the password from the description and change the account's password." }
    @{ T = 'Reversible password encryption'; C = 'Passwords & Credentials'; P = 'eversible password encryption'; R = "Disable 'Store password using reversible encryption' and reset affected passwords." }
    @{ T = 'Password not required'; C = 'Passwords & Credentials'; P = 'Password not required|PASSWD_NOTREQD'; R = 'Clear the flag (Set-ADAccountControl -PasswordNotRequired $false) and set a strong password.' }
    @{ T = 'Password never expires'; C = 'Passwords & Credentials'; P = 'Password never expires'; R = "Turn off 'Password never expires'; for service accounts use gMSAs (automatic rotation)." }
    @{ T = 'Old passwords'; C = 'Passwords & Credentials'; P = '^Password is .* days old'; R = 'Rotate the password; move service accounts to gMSAs.' }
    @{ T = 'No admin password policy'; C = 'Passwords & Credentials'; P = 'Admins only have the default password policy|Admin fine-grained policy'; R = 'Create a fine-grained password policy for admin groups with 14+ characters.' }
    @{ T = 'Weak default password policy'; C = 'Passwords & Credentials'; P = 'minimum length is|^Password history is'; R = 'Minimum length 12+ (14+ for admins), history 24; use fine-grained policies where needed.' }
    @{ T = 'No account lockout'; C = 'Passwords & Credentials'; P = 'No account lockout'; R = 'Set an account lockout threshold (e.g. 10) to slow password spraying.' }
    @{ T = 'Computers without LAPS'; C = 'Passwords & Credentials'; P = 'No LAPS'; R = 'Deploy Windows LAPS to all workstations and member servers.' }
    @{ T = 'LAPS password not rotating'; C = 'Passwords & Credentials'; P = 'LAPS password past expiry'; R = 'Check the LAPS policy and client on these hosts.' }
    # --- Host hardening ---
    @{ T = 'Print Spooler on DCs'; C = 'Host Hardening'; P = 'Print Spooler reachable on a domain controller'; R = 'Stop and disable the Print Spooler service on all DCs.' }
    @{ T = 'SMBv1 enabled'; C = 'Host Hardening'; P = 'SMBv1 enabled'; R = 'Disable SMBv1 (Set-SmbServerConfiguration -EnableSMB1Protocol $false) and remove the feature.' }
    @{ T = 'SMB signing not required'; C = 'Host Hardening'; P = 'SMB signing not required'; R = "Require SMB signing by GPO: 'Microsoft network server: Digitally sign communications (always)'." }
    @{ T = 'Individual local admins'; C = 'Host Hardening'; P = 'Individual user account is a local admin'; R = 'Grant local admin through groups, not individual accounts.' }
    @{ T = 'Broad groups are local admins'; C = 'Host Hardening'; P = 'is a local admin'; R = 'Remove broad groups from local Administrators; use LAPS and a dedicated admin group per tier.' }
    @{ T = 'Unsupported operating systems'; C = 'Host Hardening'; P = 'Out of support since'; R = 'Upgrade, or isolate the host until it can be replaced; it gets no security updates.' }
    @{ T = 'OS support ending soon'; C = 'Host Hardening'; P = 'Support ends'; R = 'Plan the upgrade before the end-of-support date.' }
    @{ T = 'No BitLocker key in AD'; C = 'Host Hardening'; P = 'No BitLocker recovery key'; R = 'Enable BitLocker and back up recovery keys to AD.' }
    # --- Monitoring & audit ---
    @{ T = 'Missing DC audit policy'; C = 'Monitoring & Audit'; P = 'not audited'; R = "Enable the subcategory under Advanced Audit Policy Configuration in the DC GPO, and set 'Audit: Force audit policy subcategory settings' to Enabled." }
    @{ T = 'Short Security log retention'; C = 'Monitoring & Audit'; P = 'Security log max size|Security log only covers'; R = 'Raise the DC Security log size (1-4 GB) and forward logs to a SIEM.' }
    # --- Stale objects & hygiene ---
    @{ T = 'FSMO role on deleted DC'; C = 'Stale Objects & Hygiene'; P = 'held by a deleted DC'; R = 'Seize the role to a live DC (Move-ADDirectoryServerOperationMasterRole -Force) and clean up metadata.' }
    @{ T = 'Stale or leftover DCs'; C = 'Stale Objects & Hygiene'; P = 'DC account not seen|DC account has never|leftover metadata|No site server object'; R = 'If the DC was removed, run metadata cleanup; otherwise check replication.' }
    @{ T = 'Single writable DC'; C = 'Stale Objects & Hygiene'; P = 'writable DC in the domain'; R = 'Add a second writable DC.' }
    @{ T = 'Orphaned adminCount'; C = 'Stale Objects & Hygiene'; P = 'adminCount=1 but no longer privileged'; R = "Clear adminCount and re-enable inheritance on the account's ACL." }
    @{ T = 'Never-used accounts'; C = 'Stale Objects & Hygiene'; P = 'Never logged on'; R = 'Disable, then delete after a review period.' }
    @{ T = 'Inactive accounts'; C = 'Stale Objects & Hygiene'; P = 'No logon in|not seen recently|stale'; R = 'Disable inactive accounts and delete after a grace period; automate it.' }
    @{ T = 'Too many group memberships'; C = 'Stale Objects & Hygiene'; P = '^Member of .* groups'; R = 'Review and remove group memberships that are no longer needed.' }
    @{ T = 'Circular / deep group nesting'; C = 'Stale Objects & Hygiene'; P = 'Circular group nesting|levels deep'; R = 'Break nesting loops and flatten deep nesting so access stays reviewable.' }
    @{ T = 'Unexpected primaryGroupID'; C = 'Stale Objects & Hygiene'; P = 'Unexpected primaryGroupID'; R = 'Set primaryGroupID back to the default for the account type.' }
    @{ T = 'Orphaned SIDs in local admins'; C = 'Stale Objects & Hygiene'; P = 'Orphaned'; R = 'Remove unresolvable SIDs from local groups.' }
    @{ T = 'Old domain functional level'; C = 'Stale Objects & Hygiene'; P = 'Functional level'; R = 'Raise the functional level once all DCs run a supported OS.' }
    @{ T = 'Unused fine-grained policy'; C = 'Stale Objects & Hygiene'; P = 'applies to nothing'; R = 'Delete the policy or link it to the intended group.' }
    @{ T = 'Empty groups / OUs'; C = 'Stale Objects & Hygiene'; P = '^Empty (group|OU)'; R = 'Delete if unused.' }
)

function Get-ADAuditIssue {
    <#
        Splits a result row into issues: Scanner, Target, Severity (per issue when the
        row has IssueSeverity), Issue text.
    #>
    param([Parameter(Mandatory)]$Row)
    $texts = @(Split-ADAuditFinding ([string]$Row.Finding))
    if (-not $texts) { return }
    $sevs = @()
    if ($Row.PSObject.Properties['IssueSeverity'] -and $Row.IssueSeverity) { $sevs = @(([string]$Row.IssueSeverity) -split ';') }
    $useSev = $sevs.Count -eq $texts.Count
    for ($i = 0; $i -lt $texts.Count; $i++) {
        [pscustomobject]@{
            Scanner  = $Row.Scanner
            Target   = $Row.Target
            Severity = $(if ($useSev) { $sevs[$i] } else { $Row.Severity })
            Issue    = $texts[$i].Trim()
        }
    }
}

function Get-ADAuditRule {
    param([string]$Scanner, [string]$Issue)
    if ($Scanner -eq 'Events') { return @{ T = 'Recent change (Events)'; C = 'Recent Changes'; R = 'Confirm the change was authorised; if not, treat as an incident.' } }
    foreach ($r in $script:ADAuditRules) { if ($Issue -match $r.P) { return $r } }
    $cat = $script:ADAuditScannerCategory[$Scanner]; if (-not $cat) { $cat = 'Stale Objects & Hygiene' }
    return @{ T = "$Scanner finding"; C = $cat; R = '' }
}

function Get-ADAuditEnrichedFinding {
    <# All issues that are not OK, with Category / Rule / Remediation #>
    param([Parameter(Mandatory)][AllowEmptyCollection()][object[]]$Rows)
    foreach ($row in $Rows) {
        if ($row.Severity -eq 'OK') { continue }
        foreach ($i in (Get-ADAuditIssue -Row $row)) {
            if ($i.Severity -eq 'OK') { continue }
            $rule = Get-ADAuditRule -Scanner $i.Scanner -Issue $i.Issue
            $title = $rule.T
            if ($i.Severity -eq 'Info' -and $title -eq "$($i.Scanner) finding") { $title = 'Information' }
            [pscustomobject][ordered]@{
                Severity    = $i.Severity
                Category    = $rule.C
                Rule        = $title
                Scanner     = $i.Scanner
                Target      = $i.Target
                Finding     = $i.Issue
                Remediation = $rule.R
            }
        }
    }
}

function Get-ADAuditScore {
    <#
        Returns: Overall (0-100), Categories (Category, Score, Rules, High, Medium, Low),
        Rules (Category, Rule, Severity, Objects, Points, Remediation)
    #>
    param([Parameter(Mandatory)][AllowEmptyCollection()][object[]]$Findings)
    $rank = @{ High = 3; Medium = 2; Low = 1 }
    $rules = @{}
    foreach ($f in $Findings) {
        if ($f.Scanner -in 'Events', 'Runner', 'Reachability') { continue }
        if (-not $rank.ContainsKey([string]$f.Severity)) { continue }
        $k = "$($f.Category)|$($f.Rule)"
        if (-not $rules.ContainsKey($k)) { $rules[$k] = [pscustomobject]@{ Category = $f.Category; Rule = $f.Rule; Severity = $f.Severity; Objects = New-Object 'System.Collections.Generic.HashSet[string]'; Remediation = $f.Remediation } }
        $r = $rules[$k]
        if ($rank[[string]$f.Severity] -gt $rank[[string]$r.Severity]) { $r.Severity = $f.Severity }
        [void]$r.Objects.Add("$($f.Scanner)|$($f.Target)")
    }
    $ruleRows = foreach ($r in $rules.Values) {
        [pscustomobject][ordered]@{ Category = $r.Category; Rule = $r.Rule; Severity = $r.Severity; Objects = $r.Objects.Count; Points = $script:ADAuditPoints[[string]$r.Severity]; Remediation = $r.Remediation }
    }
    $ruleRows = @($ruleRows | Sort-Object @{ Expression = { - $rank[[string]$_.Severity] } }, Category, @{ Expression = { - $_.Objects } })

    $cats = foreach ($c in $script:ADAuditCategories) {
        $rs = @($ruleRows | Where-Object { $_.Category -eq $c })
        [pscustomobject][ordered]@{
            Category = $c
            Score    = [math]::Min(100, [int](($rs | Measure-Object -Property Points -Sum).Sum))
            Rules    = $rs.Count
            High     = @($rs | Where-Object Severity -eq 'High').Count
            Medium   = @($rs | Where-Object Severity -eq 'Medium').Count
            Low      = @($rs | Where-Object Severity -eq 'Low').Count
        }
    }
    $cats = @($cats)
    [pscustomobject]@{ Overall = [int](($cats | Measure-Object -Property Score -Maximum).Maximum); Categories = $cats; Rules = $ruleRows }
}
#endregion lib/Remediation.ps1

#region Scanners/Accounts.ps1
<#
    Accounts (PingCastle equivalents: user/admin account hygiene rules)
    AD-only. Reviews every ENABLED user account and reports:

      Privileged accounts   - in Domain Admins / Administrators / other admin groups (direct or nested)
      Service accounts      - user accounts with an SPN or a name matching -ServiceAccountPattern, plus gMSAs
      Password never expires, password not required, reversible encryption, DES-only
      Never logged on, stale (no logon in -ActiveDays), old passwords (> -PasswordAgeDays)
      Kerberoastable (SPN on user), AS-REP roastable (no pre-auth)
      Unconstrained / constrained delegation (users and non-DC computers)
      Too many group memberships (> -MaxGroupMemberships), SID history, orphaned adminCount
      Privileged accounts not 'sensitive and cannot be delegated' / not in Protected Users
      Password-like text in the description field
      Cleartext password attributes (userPassword, unixUserPassword, msSFU30Password, os400Password)
      Unexpected primaryGroupID (hidden group membership) on users and computers

    Only accounts with at least one issue, plus all privileged and service accounts,
    are written out (so the CSV doubles as a privileged/service account inventory).
#>

function Invoke-ADAuditAccountScan {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]$Privileged,
        [string]$Server,
        [string]$SearchBase,
        [pscredential]$Credential,
        [int]$ActiveDays = 90,
        [int]$NeverLoggedOnGraceDays = 30,
        [int]$PasswordAgeDays = 365,
        [int]$MaxGroupMemberships = 20,
        [string]$ServiceAccountPattern = '^(svc|srv|sa|sql|app|service)[-_.]|[-_.](svc|service|sa)$|^svc'
    )

    $now = [DateTime]::UtcNow
    $props = 'sAMAccountName', 'displayName', 'distinguishedName', 'userAccountControl', 'lastLogonTimestamp', 'pwdLastSet',
             'whenCreated', 'servicePrincipalName', 'memberOf', 'adminCount', 'sIDHistory', 'description', 'msDS-AllowedToDelegateTo',
             'primaryGroupID', 'objectSid', 'userPassword', 'unixUserPassword', 'msSFU30Password', 'os400Password'
    $filter = '(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))'
    $privilegedRids = 512, 516, 518, 519, 520, 521, 526, 527, 498
    # Adds to the $sev / $issues lists of the current loop iteration (dynamic scope)
    function Add-Issue([string]$s, [string]$t) { $sev.Add($s); $issues.Add($t) }

    foreach ($u in (Invoke-ADAuditLdapQuery -Server $Server -SearchBase $SearchBase -Credential $Credential -Filter $filter -Properties $props)) {
        $sam = [string]$u.sAMAccountName
        $dn = [string]$u.distinguishedName
        $uac = [int]$u.userAccountControl
        $spns = @($u.servicePrincipalName | Where-Object { $_ })
        $groups = @($u.memberOf | Where-Object { $_ })
        $lastLogon = ConvertFrom-ADAuditFileTime $u.lastLogonTimestamp
        $pwdSet = ConvertFrom-ADAuditFileTime $u.pwdLastSet
        $created = $null; if ($u.whenCreated) { $created = ([DateTime]$u.whenCreated).ToUniversalTime() }

        $isPriv = $Privileged.MapByMember.ContainsKey($dn)
        $privGroups = $(if ($isPriv) { ($Privileged.MapByMember[$dn] -join ', ') } else { $null })
        $isSvc = ($spns.Count -gt 0) -or ($sam -match $ServiceAccountPattern)
        $isProtected = $Privileged.ProtectedUsers.Contains($dn)
        $neverExpires = ($uac -band 0x10000) -ne 0
        $pwdAge = $(if ($pwdSet) { [int]($now - $pwdSet).TotalDays } else { $null })

        $issues = New-Object System.Collections.Generic.List[string]
        $sev = New-Object System.Collections.Generic.List[string]

        if ($uac -band 0x400000) { Add-Issue 'High' 'Kerberos pre-auth not required (AS-REP roastable)' }
        if ($uac -band 0x80) { Add-Issue 'High' 'Reversible password encryption enabled' }
        if ($uac -band 0x20) { Add-Issue $(if ($isPriv) { 'High' } else { 'Medium' }) 'Password not required (PASSWD_NOTREQD)' }
        if ($uac -band 0x200000) { Add-Issue 'Medium' 'DES-only Kerberos encryption' }
        if ($uac -band 0x80000) { Add-Issue 'High' 'Unconstrained delegation on user account' }
        if ($uac -band 0x1000000) { Add-Issue 'Medium' 'Constrained delegation with protocol transition' }
        elseif (@($u.'msDS-AllowedToDelegateTo' | Where-Object { $_ }).Count -gt 0) { Add-Issue 'Low' 'Constrained delegation configured' }
        if ($spns.Count -gt 0 -and $sam -ne 'krbtgt') {
            Add-Issue $(if ($isPriv) { 'High' } else { 'Medium' }) $(if ($isPriv) { 'Privileged account has SPN (Kerberoastable)' } else { 'User account has SPN (Kerberoastable) - consider gMSA' })
        }
        if ($neverExpires) {
            Add-Issue $(if ($isPriv) { 'High' } elseif ($isSvc) { 'Medium' } else { 'Low' }) 'Password never expires'
        }
        if (-not $lastLogon) {
            if ($created -and ($now - $created).TotalDays -gt $NeverLoggedOnGraceDays) {
                Add-Issue $(if ($isPriv) { 'Medium' } else { 'Low' }) 'Never logged on'
            }
        }
        elseif (($now - $lastLogon).TotalDays -gt $ActiveDays) {
            Add-Issue $(if ($isPriv) { 'Medium' } else { 'Low' }) ("No logon in {0} days (stale)" -f [int]($now - $lastLogon).TotalDays)
        }
        if ($null -ne $u.pwdLastSet -and [Int64]"$($u.pwdLastSet)" -eq 0) { Add-Issue 'Info' 'Must change password at next logon' }
        elseif ($pwdAge -and $pwdAge -gt $PasswordAgeDays) {
            Add-Issue $(if ($isPriv -or $isSvc) { 'Medium' } else { 'Low' }) "Password is $pwdAge days old"
        }
        if (@($u.sIDHistory | Where-Object { $_ }).Count -gt 0) { Add-Issue 'Medium' 'sIDHistory present' }
        if ($groups.Count -gt $MaxGroupMemberships) { Add-Issue 'Low' "Member of $($groups.Count) groups (limit $MaxGroupMemberships)" }
        if ($u.adminCount -eq 1 -and -not $isPriv) { Add-Issue 'Low' 'adminCount=1 but no longer privileged (orphaned AdminSDHolder ACL)' }
        if ($isPriv) {
            if (-not $isProtected) { Add-Issue 'Low' 'Privileged account not in Protected Users' }
            if ((($uac -band 0x100000) -eq 0) -and -not $isProtected) { Add-Issue 'Medium' "Privileged account not marked 'sensitive and cannot be delegated'" }
        }
        if ("$($u.description)" -match '(?i)\b(pass(word)?|pwd|p/w|kennwort|mot de passe)\b\s*[:=]?') { Add-Issue 'Medium' 'Description may contain a password' }
        foreach ($a in 'userPassword', 'unixUserPassword', 'msSFU30Password', 'os400Password') {
            if ($null -ne $u.$a -and "$($u.$a)" -ne '') { Add-Issue 'High' "Cleartext password stored in $a attribute" }
        }
        $pgid = $(if ($null -ne $u.primaryGroupID) { [int]$u.primaryGroupID } else { 513 })
        $rid = $(if ((ConvertTo-ADAuditSidString $u.objectSid) -match '-(\d+)$') { [int64]$Matches[1] } else { 0 })
        $expectedPg = $(if ($rid -eq 501) { 514 } else { 513 })   # Guest -> Domain Guests
        if ($pgid -ne $expectedPg -and $pgid -ne 513) {
            if ($pgid -in $privilegedRids) { Add-Issue 'High' "Primary group is privileged (RID $pgid) - hidden membership" }
            else { Add-Issue 'Low' "Unexpected primaryGroupID $pgid" }
        }

        if ($issues.Count -eq 0 -and -not $isPriv -and -not $isSvc) { continue }

        New-ADAuditResult -Scanner 'Accounts' -Target $sam -Severity (Get-ADAuditMaxSeverity @($sev)) -Finding ($issues -join '; ') -Data ([ordered]@{
            ObjectType           = 'user'
            DisplayName          = [string]$u.displayName
            IsPrivileged         = $isPriv
            PrivilegedGroups     = $privGroups
            IsServiceAccount     = $isSvc
            InProtectedUsers     = $isProtected
            PasswordNeverExpires = $neverExpires
            LastLogonUtc         = $lastLogon
            PasswordLastSetUtc   = $pwdSet
            PasswordAgeDays      = $pwdAge
            WhenCreatedUtc       = $created
            GroupCount           = $groups.Count
            SPNs                 = ($spns -join '; ')
            Description          = [string]$u.description
            PrimaryGroupId       = $pgid
            DistinguishedName    = $dn
            IssueSeverity        = (@($sev) -join ';')
        })
    }

    # Computers whose primaryGroupID doesn't match their type (515 member, 516 DC, 521 RODC)
    $pf = '(&(objectCategory=computer)(!(primaryGroupID=515))(!(primaryGroupID=516))(!(primaryGroupID=521)))'
    $cf = '(&(objectCategory=computer)(|(&(primaryGroupID=516)(!(userAccountControl:1.2.840.113556.1.4.803:=8192)))(&(primaryGroupID=521)(!(userAccountControl:1.2.840.113556.1.4.803:=67108864)))))'
    foreach ($q in @($pf, $cf)) {
        foreach ($c in (Invoke-ADAuditLdapQuery -Server $Server -SearchBase $SearchBase -Credential $Credential -Filter $q -Properties 'sAMAccountName', 'distinguishedName', 'primaryGroupID')) {
            $pg = [int]$c.primaryGroupID
            $sev1 = $(if ($pg -in $privilegedRids) { 'High' } else { 'Low' })
            $txt = $(if ($pg -in 516, 521) { "Non-DC computer has DC primaryGroupID $pg" } elseif ($sev1 -eq 'High') { "Primary group is privileged (RID $pg) - hidden membership" } else { "Unexpected primaryGroupID $pg" })
            New-ADAuditResult -Scanner 'Accounts' -Target ([string]$c.sAMAccountName) -Severity $sev1 -Finding $txt -Data ([ordered]@{
                ObjectType = 'computer'; PrimaryGroupId = $pg; DistinguishedName = [string]$c.distinguishedName
            })
        }
    }

    # Non-DC computers with unconstrained delegation (DC = 0x2000, RODC = 0x4000000)
    $cf = '(&(objectCategory=computer)(userAccountControl:1.2.840.113556.1.4.803:=524288)(!(userAccountControl:1.2.840.113556.1.4.803:=8192))(!(userAccountControl:1.2.840.113556.1.4.803:=67108864))(!(userAccountControl:1.2.840.113556.1.4.803:=2)))'
    foreach ($c in (Invoke-ADAuditLdapQuery -Server $Server -SearchBase $SearchBase -Credential $Credential -Filter $cf -Properties 'sAMAccountName', 'distinguishedName')) {
        New-ADAuditResult -Scanner 'Accounts' -Target ([string]$c.sAMAccountName) -Severity 'High' -Finding 'Non-DC computer trusted for unconstrained delegation' -Data ([ordered]@{
            ObjectType = 'computer'; DistinguishedName = [string]$c.distinguishedName
        })
    }

    # Group Managed Service Accounts (inventory - the good kind of service account)
    try {
        foreach ($g in (Invoke-ADAuditLdapQuery -Server $Server -SearchBase $SearchBase -Credential $Credential -Filter '(objectClass=msDS-GroupManagedServiceAccount)' -Properties 'sAMAccountName', 'distinguishedName', 'servicePrincipalName')) {
            New-ADAuditResult -Scanner 'Accounts' -Target ([string]$g.sAMAccountName) -Severity 'OK' -Finding 'gMSA' -Data ([ordered]@{
                ObjectType = 'gMSA'; IsServiceAccount = $true; IsPrivileged = $Privileged.MapByMember.ContainsKey([string]$g.distinguishedName)
                SPNs = (@($g.servicePrincipalName | Where-Object { $_ }) -join '; '); DistinguishedName = [string]$g.distinguishedName
            })
        }
    }
    catch { }
}
#endregion Scanners/Accounts.ps1

#region Scanners/AuditPolicy.ps1
<#
    AuditPolicy
    Reads (never sets) the audit policy that Group Policy applies to domain controllers:

      1. Finds GPOs linked to the domain root and to OU=Domain Controllers (gPLink),
         honouring disabled links, enforced links, block inheritance and GPOs with
         computer settings disabled.
      2. Reads each GPO's files from SYSVOL:
           Machine\Microsoft\Windows NT\Audit\audit.csv     (advanced audit policy)
           Machine\Microsoft\Windows NT\SecEdit\GptTmpl.inf (legacy [Event Audit], [Security Log])
      3. Works out the winning value per subcategory and flags subcategories that
         AD security monitoring (and the Events scanner) depends on.

    Limits: GPOs linked to AD sites, local policy and auditpol changes made by hand
    are not visible here. Confirm on a DC with:  auditpol /get /category:*
    SYSVOL is read over SMB with the current Windows logon, not -Credential.
#>

$script:ADAuditSubcategories = [ordered]@{
    # GUID suffix -69AE-11D9-BED3-505054503030
    '0CCE923F' = @{ Name = 'Credential Validation'; Category = 'Account Logon'; Need = 3; Why = 'NTLM auth on DCs (4776), password spraying' }
    '0CCE9242' = @{ Name = 'Kerberos Authentication Service'; Category = 'Account Logon'; Need = 3; Why = 'TGT requests (4768/4771), AS-REP roasting, spraying' }
    '0CCE9240' = @{ Name = 'Kerberos Service Ticket Operations'; Category = 'Account Logon'; Need = 3; Why = 'Service tickets (4769), Kerberoasting' }
    '0CCE9235' = @{ Name = 'User Account Management'; Category = 'Account Management'; Need = 3; Why = 'Account create/change/delete, resets, SID history, DSRM (4720-4738, 4765, 4794)' }
    '0CCE9236' = @{ Name = 'Computer Account Management'; Category = 'Account Management'; Need = 1; Why = 'Computer accounts created/changed (4741/4742), MachineAccountQuota abuse' }
    '0CCE9237' = @{ Name = 'Security Group Management'; Category = 'Account Management'; Need = 1; Why = 'Group membership changes incl. Domain Admins (4728/4732/4756)' }
    '0CCE923A' = @{ Name = 'Other Account Management Events'; Category = 'Account Management'; Need = 1; Why = 'Password policy checks (4782, 4793)' }
    '0CCE923B' = @{ Name = 'Directory Service Access'; Category = 'DS Access'; Need = 3; Why = 'Object access (4662), DCSync detection' }
    '0CCE923C' = @{ Name = 'Directory Service Changes'; Category = 'DS Access'; Need = 1; Why = 'Attribute changes (5136): SPN, delegation, shadow credentials, ACLs' }
    '0CCE9215' = @{ Name = 'Logon'; Category = 'Logon/Logoff'; Need = 3; Why = 'Logons on DCs (4624/4625)' }
    '0CCE9217' = @{ Name = 'Account Lockout'; Category = 'Logon/Logoff'; Need = 2; Why = 'Failed logons to locked accounts (4625)' }
    '0CCE921B' = @{ Name = 'Special Logon'; Category = 'Logon/Logoff'; Need = 1; Why = 'Privileged logons (4672)' }
    '0CCE922F' = @{ Name = 'Audit Policy Change'; Category = 'Policy Change'; Need = 1; Why = 'Someone turning auditing off (4719)' }
    '0CCE9230' = @{ Name = 'Authentication Policy Change'; Category = 'Policy Change'; Need = 1; Why = 'Trusts, Kerberos policy changes (4706, 4713, 4716)' }
    '0CCE9228' = @{ Name = 'Sensitive Privilege Use'; Category = 'Privilege Use'; Need = 3; Why = 'Use of sensitive privileges (4673/4674)' }
    '0CCE9211' = @{ Name = 'Security System Extension'; Category = 'System'; Need = 1; Why = 'New services / auth packages (4697, 4610-4614)' }
    '0CCE922B' = @{ Name = 'Process Creation'; Category = 'Detailed Tracking'; Need = 1; Why = 'Process execution on DCs (4688)' }
}

$script:ADAuditLegacyAuditKeys = @{
    'AuditSystemEvents'    = 'System'
    'AuditLogonEvents'     = 'Logon/Logoff'
    'AuditObjectAccess'    = 'Object Access'
    'AuditPrivilegeUse'    = 'Privilege Use'
    'AuditProcessTracking' = 'Detailed Tracking'
    'AuditPolicyChange'    = 'Policy Change'
    'AuditAccountManage'   = 'Account Management'
    'AuditDSAccess'        = 'DS Access'
    'AuditAccountLogon'    = 'Account Logon'
}

function ConvertTo-ADAuditAuditSettingText {
    param($Value)
    if ($null -eq $Value) { return 'Not configured' }
    switch ([int]$Value) { 0 { 'No Auditing' } 1 { 'Success' } 2 { 'Failure' } 3 { 'Success and Failure' } default { "Value $Value" } }
}

function ConvertFrom-ADAuditGpLink {
    <#
        gPLink = [LDAP://cn={GUID},cn=policies,...;0][LDAP://...;2]
        Options: 0 enabled, 1 link disabled, 2 enforced, 3 disabled+enforced.
        Entries are stored in reverse link order: the LAST entry is link order 1
        (highest precedence), so string order = lowest -> highest precedence.
    #>
    param([string]$GpLink)
    if (-not $GpLink) { return @() }
    foreach ($m in [regex]::Matches($GpLink, '\[LDAP://([^;\]]+);(\d+)\]')) {
        $opt = [int]$m.Groups[2].Value
        [pscustomobject]@{
            GpoDN    = $m.Groups[1].Value
            Disabled = (($opt -band 1) -ne 0)
            Enforced = (($opt -band 2) -ne 0)
        }
    }
}

function Read-ADAuditIniSection {
    param([string[]]$Lines, [string]$Section)
    $out = @{}
    $in = $false
    foreach ($l in $Lines) {
        $t = $l.Trim()
        if ($t -match '^\[(.+)\]$') { $in = ($Matches[1] -ieq $Section); continue }
        if ($in -and $t -match '^([^=;]+?)\s*=\s*(.*)$') { $out[$Matches[1]] = $Matches[2] }
    }
    return $out
}

function Get-ADAuditGpoAuditSettings {
    <#
        Reads one GPO's audit settings from SYSVOL. Returns:
          Advanced : GUID(8-char prefix, upper) -> setting value (0-3)
          Legacy   : category -> value (0-3)
          SecurityLogMaxKB, Error
    #>
    param([Parameter(Mandatory)][string]$FileSysPath)

    $adv = @{}; $legacy = @{}; $maxKb = $null; $errs = @()

    $auditCsv = Join-Path $FileSysPath 'Machine\Microsoft\Windows NT\Audit\audit.csv'
    try {
        if (Test-Path -LiteralPath $auditCsv) {
            foreach ($row in (Import-Csv -LiteralPath $auditCsv)) {
                $guid = [string]$row.'Subcategory GUID'
                $val = [string]$row.'Setting Value'
                if ($val -notmatch '^\d+$') { continue }
                if ($guid -match '\{?([0-9A-Fa-f]{8})-') { $adv[$Matches[1].ToUpperInvariant()] = [int]$val }
            }
        }
    }
    catch { $errs += "audit.csv: $($_.Exception.Message)" }

    $inf = Join-Path $FileSysPath 'Machine\Microsoft\Windows NT\SecEdit\GptTmpl.inf'
    try {
        if (Test-Path -LiteralPath $inf) {
            $lines = Get-Content -LiteralPath $inf
            $ea = Read-ADAuditIniSection -Lines $lines -Section 'Event Audit'
            foreach ($k in $ea.Keys) {
                if ($script:ADAuditLegacyAuditKeys.ContainsKey($k) -and $ea[$k] -match '^\d+$') { $legacy[$script:ADAuditLegacyAuditKeys[$k]] = [int]$ea[$k] }
            }
            $sl = Read-ADAuditIniSection -Lines $lines -Section 'Security Log'
            if ($sl['MaximumLogSize'] -match '^\d+$') { $maxKb = [int]$sl['MaximumLogSize'] }
        }
    }
    catch { $errs += "GptTmpl.inf: $($_.Exception.Message)" }

    [pscustomobject]@{ Advanced = $adv; Legacy = $legacy; SecurityLogMaxKB = $maxKb; Error = ($errs -join '; ') }
}

function Invoke-ADAuditAuditPolicyScan {
    [CmdletBinding()]
    param([string]$Server, [pscredential]$Credential, [int]$MinSecurityLogMB = 1024)

    $nc = Get-ADAuditDefaultNamingContext -Server $Server -Credential $Credential
    $domain = ConvertTo-ADAuditDnsName $nc
    $dcOu = "OU=Domain Controllers,$nc"

    $domObj = Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase $nc -Scope Base -Filter '(objectClass=*)' -Properties 'gPLink' | Select-Object -First 1
    $ouObj = Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase $dcOu -Scope Base -Filter '(objectClass=*)' -Properties 'gPLink', 'gPOptions' | Select-Object -First 1
    $blockInheritance = ($null -ne $ouObj.gPOptions) -and (([int]$ouObj.gPOptions -band 1) -ne 0)

    $gpos = @{}
    foreach ($g in (Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase "CN=Policies,CN=System,$nc" -Filter '(objectClass=groupPolicyContainer)' -Properties 'distinguishedName', 'displayName', 'gPCFileSysPath', 'flags')) {
        $gpos[([string]$g.distinguishedName).ToLowerInvariant()] = $g
    }

    # Lowest -> highest precedence for computers in OU=Domain Controllers
    $domLinks = @(ConvertFrom-ADAuditGpLink ([string]$domObj.gPLink))
    $ouLinks = @(ConvertFrom-ADAuditGpLink ([string]$ouObj.gPLink))
    $ordered = @()
    if (-not $blockInheritance) { $ordered += $domLinks | Where-Object { -not $_.Enforced } | ForEach-Object { $_ | Add-Member -NotePropertyName Scope -NotePropertyValue 'Domain' -PassThru } }
    $ordered += $ouLinks | Where-Object { -not $_.Enforced } | ForEach-Object { $_ | Add-Member -NotePropertyName Scope -NotePropertyValue 'Domain Controllers OU' -PassThru }
    $ordered += $ouLinks | Where-Object { $_.Enforced } | ForEach-Object { $_ | Add-Member -NotePropertyName Scope -NotePropertyValue 'Domain Controllers OU (enforced)' -PassThru }
    $ordered += $domLinks | Where-Object { $_.Enforced } | ForEach-Object { $_ | Add-Member -NotePropertyName Scope -NotePropertyValue 'Domain (enforced)' -PassThru }

    $effAdv = @{}; $effLegacy = @{}; $logMax = $null
    $applied = @()
    foreach ($l in $ordered) {
        if ($l.Disabled) { continue }
        $g = $gpos[$l.GpoDN.ToLowerInvariant()]
        if (-not $g) {
            New-ADAuditResult -Scanner 'AuditPolicy' -Target $l.GpoDN -Severity 'Info' -Finding "Linked GPO not found or not readable ($($l.Scope))" -Data ([ordered]@{ Check = 'GPO' })
            continue
        }
        $flags = 0; if ($null -ne $g.flags) { $flags = [int]$g.flags }
        if (($flags -band 2) -ne 0) { continue }   # computer settings disabled
        $name = [string]$g.displayName
        $applied += "$name [$($l.Scope)]"

        $s = Get-ADAuditGpoAuditSettings -FileSysPath ([string]$g.gPCFileSysPath)
        if ($s.Error) {
            New-ADAuditResult -Scanner 'AuditPolicy' -Target $name -Severity 'Info' -Finding "Could not read GPO files: $($s.Error)" -Data ([ordered]@{ Check = 'GPO'; Path = [string]$g.gPCFileSysPath })
        }
        foreach ($k in $s.Advanced.Keys) { $effAdv[$k] = @{ Value = $s.Advanced[$k]; Gpo = $name } }
        foreach ($k in $s.Legacy.Keys) { $effLegacy[$k] = @{ Value = $s.Legacy[$k]; Gpo = $name } }
        if ($null -ne $s.SecurityLogMaxKB) { $logMax = @{ Value = $s.SecurityLogMaxKB; Gpo = $name } }
    }

    New-ADAuditResult -Scanner 'AuditPolicy' -Target $domain -Severity 'Info' -Finding $(if ($applied) { 'GPOs applied to DCs (lowest to highest precedence): ' + ($applied -join ' > ') } else { 'No GPOs apply to OU=Domain Controllers' }) -Data ([ordered]@{
        Check = 'Scope'; BlockInheritance = $blockInheritance
    })

    $anyAdvanced = $effAdv.Count -gt 0
    foreach ($guid in $script:ADAuditSubcategories.Keys) {
        $sc = $script:ADAuditSubcategories[$guid]
        $value = $null; $source = $null; $kind = $null
        if ($effAdv.ContainsKey($guid)) { $value = $effAdv[$guid].Value; $source = $effAdv[$guid].Gpo; $kind = 'Advanced' }
        elseif ($effLegacy.ContainsKey($sc.Category)) {
            $value = $effLegacy[$sc.Category].Value; $source = $effLegacy[$sc.Category].Gpo; $kind = 'Legacy category'
        }

        $need = [int]$sc.Need
        $have = $(if ($null -eq $value) { 0 } else { [int]$value })
        $missing = $need -band (-bnot $have)
        $sev = 'OK'; $finding = ''
        if ($missing -ne 0) {
            $what = @(); if ($missing -band 1) { $what += 'Success' }; if ($missing -band 2) { $what += 'Failure' }
            $sev = $(if ($missing -band 1) { 'Medium' } else { 'Low' })
            $finding = "$($what -join ' and ') not audited - $($sc.Why)"
            if ($null -eq $value) { $finding += ' (not set by any DC GPO; Windows default applies)' }
        }
        if ($kind -eq 'Legacy category' -and $anyAdvanced) { $finding = ($finding + ' [legacy category setting may be ignored because advanced audit policy is also configured]').Trim() }

        New-ADAuditResult -Scanner 'AuditPolicy' -Target $sc.Name -Severity $sev -Finding $finding -Data ([ordered]@{
            Check = 'Subcategory'; Category = $sc.Category
            Required = (ConvertTo-ADAuditAuditSettingText $need)
            Effective = (ConvertTo-ADAuditAuditSettingText $value)
            SetBy = $source; Source = $kind
        })
    }

    $sev = 'OK'; $finding = ''
    if ($null -eq $logMax) { $sev = 'Info'; $finding = 'Security log size not set under Security Settings > Event Log (an Administrative Templates setting may still set it; the Events scanner reports actual retention)' }
    elseif ($logMax.Value -lt ($MinSecurityLogMB * 1024)) { $sev = 'Low'; $finding = "Security log max size $([int]($logMax.Value / 1024)) MB (recommend $MinSecurityLogMB MB+ on DCs, or forward to SIEM)" }
    New-ADAuditResult -Scanner 'AuditPolicy' -Target 'Security log size' -Severity $sev -Finding $finding -Data ([ordered]@{
        Check = 'LogSize'; Effective = $(if ($logMax) { "$([int]($logMax.Value / 1024)) MB" } else { 'Not configured' }); SetBy = $(if ($logMax) { $logMax.Gpo } else { $null })
    })
}
#endregion Scanners/AuditPolicy.ps1

#region Scanners/DomainControllers.ps1
<#
    DomainControllers
    AD-only (plus one DNS lookup per DC). Inventories every DC with its site,
    IP addresses, OS, RODC / Global Catalog status and FSMO roles.

    Flags:
      - Only one writable DC in the domain (no redundancy)
      - DC computer account not seen for -DcStaleDays (decommissioned without cleanup?)
      - FSMO role held by a deleted / unresolvable DC
      - Site server objects with no matching DC computer (leftover metadata)
#>

function Invoke-ADAuditDomainControllerScan {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][AllowEmptyCollection()][object[]]$Computers,
        [string]$Server,
        [pscredential]$Credential,
        [int]$DcStaleDays = 30
    )

    $rootDse = Get-ADAuditRootDse -Server $Server -Credential $Credential
    $nc = $rootDse.DefaultNamingContext
    $config = $rootDse.ConfigurationNamingContext
    $domain = ConvertTo-ADAuditDnsName $nc

    # Site server objects: CN=<DC>,CN=Servers,CN=<Site>,CN=Sites,<config>
    $servers = @(Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase "CN=Sites,$config" -Filter '(objectClass=server)' -Properties 'distinguishedName', 'dNSHostName', 'serverReference')
    $ntds = @(Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase "CN=Sites,$config" -Filter '(objectClass=nTDSDSA)' -Properties 'distinguishedName', 'options')
    $gcByServer = @{}
    foreach ($n in $ntds) {
        $opt = 0; if ($null -ne $n.options) { $opt = [int]$n.options }
        $gcByServer[(Get-ADAuditParentDN ([string]$n.distinguishedName))] = (($opt -band 1) -ne 0)
    }
    $serverByComputer = @{}
    foreach ($s in $servers) {
        if ($s.serverReference) { $serverByComputer[[string]$s.serverReference] = $s }
    }

    # FSMO role owners (values are NTDS Settings DNs)
    $roles = @{}
    $roleSources = @(
        @{ Role = 'PDC'; Base = $nc },
        @{ Role = 'RID'; Base = "CN=RID Manager`$,CN=System,$nc" },
        @{ Role = 'Infrastructure'; Base = "CN=Infrastructure,$nc" },
        @{ Role = 'Schema'; Base = "CN=Schema,$config" },
        @{ Role = 'DomainNaming'; Base = "CN=Partitions,$config" }
    )
    foreach ($r in $roleSources) {
        try {
            $o = Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase $r.Base -Scope Base -Filter '(objectClass=*)' -Properties 'fSMORoleOwner' | Select-Object -First 1
            $owner = [string]$o.fSMORoleOwner
            if ($owner) {
                $serverDn = Get-ADAuditParentDN $owner
                if (-not $roles.ContainsKey($serverDn)) { $roles[$serverDn] = New-Object System.Collections.Generic.List[string] }
                $roles[$serverDn].Add($r.Role)
                if ($owner -match '\\0ADEL:|CN=Deleted Objects') {
                    New-ADAuditResult -Scanner 'DomainControllers' -Target $r.Role -Severity 'High' -Finding "FSMO role $($r.Role) is held by a deleted DC ($owner)" -Data ([ordered]@{ Check = 'FSMO' })
                }
            }
        }
        catch { New-ADAuditResult -Scanner 'DomainControllers' -Target $r.Role -Severity 'Info' -Finding "Could not read FSMO owner: $($_.Exception.Message)" -Data ([ordered]@{ Check = 'FSMO' }) }
    }

    $dcs = @($Computers | Where-Object { $_.IsDomainController })
    $now = [DateTime]::UtcNow
    $writable = 0
    $seenServers = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)

    foreach ($dc in $dcs) {
        $srv = $serverByComputer[$dc.DistinguishedName]
        $site = $null; $isGc = $null; $dcRoles = @()
        if ($srv) {
            $srvDn = [string]$srv.distinguishedName
            [void]$seenServers.Add($srvDn)
            if ($srvDn -match '^CN=[^,]+,CN=Servers,CN=([^,]+),CN=Sites,') { $site = $Matches[1] }
            $isGc = $gcByServer[$srvDn]
            if ($roles.ContainsKey($srvDn)) { $dcRoles = @($roles[$srvDn]) }
        }
        $isRodc = [bool]$dc.IsReadOnly
        if (-not $isRodc) { $writable++ }

        $ips = $null
        try { $ips = (@([System.Net.Dns]::GetHostAddresses($dc.DnsHostName) | ForEach-Object { $_.IPAddressToString }) -join ', ') } catch { $ips = '(DNS lookup failed)' }

        $issues = @(); $sev = @()
        if (-not $dc.LastLogonUtc -or ($now - $dc.LastLogonUtc).TotalDays -gt $DcStaleDays) {
            $issues += $(if ($dc.LastLogonUtc) { "DC account not seen for $([int]($now - $dc.LastLogonUtc).TotalDays) days (decommissioned without metadata cleanup?)" } else { 'DC account has never logged on' })
            $sev += 'Medium'
        }
        if (-not $srv) { $issues += 'No site server object found for this DC'; $sev += 'Low' }

        New-ADAuditResult -Scanner 'DomainControllers' -Target $dc.Name -Severity (Get-ADAuditMaxSeverity $sev) -Finding ($issues -join '; ') -Data ([ordered]@{
            Check           = 'Inventory'
            DnsHostName     = $dc.DnsHostName
            Site            = $site
            IPAddresses     = $ips
            OperatingSystem = $dc.OperatingSystem
            OSVersion       = $dc.OSVersion
            IsReadOnly      = $isRodc
            IsGlobalCatalog = $isGc
            FsmoRoles       = ($dcRoles -join ', ')
            LastLogonUtc    = $dc.LastLogonUtc
            IssueSeverity = (@($sev) -join ';')
        })
    }

    if ($dcs.Count -gt 0 -and $writable -lt 2) {
        New-ADAuditResult -Scanner 'DomainControllers' -Target $domain -Severity 'Medium' -Finding "Only $writable writable DC in the domain (no redundancy)" -Data ([ordered]@{ Check = 'Redundancy' })
    }

    # Server objects whose DC belongs to this domain but no enabled DC computer matches
    $dcDns = @{}
    foreach ($dc in $dcs) { $dcDns[$dc.DnsHostName.ToLowerInvariant()] = $true }
    foreach ($s in $servers) {
        $sdn = [string]$s.distinguishedName
        if ($seenServers.Contains($sdn)) { continue }
        $h = [string]$s.dNSHostName
        if (-not $h -or -not $h.ToLowerInvariant().EndsWith(".$($domain.ToLowerInvariant())")) { continue }  # other domains in the forest
        if (-not $gcByServer.ContainsKey($sdn)) { continue }  # server without NTDS Settings = not a DC (e.g. leftover from demotion is fine)
        if ($dcDns.ContainsKey($h.ToLowerInvariant())) { continue }
        New-ADAuditResult -Scanner 'DomainControllers' -Target $h -Severity 'Low' -Finding 'NTDS Settings exist but no enabled DC computer account matches (leftover metadata?)' -Data ([ordered]@{ Check = 'Metadata'; DistinguishedName = $sdn })
    }
}
#endregion Scanners/DomainControllers.ps1

#region Scanners/DomainPolicy.ps1
<#
    DomainPolicy (PingCastle equivalents: domain-level stale/privileged/anomaly rules)
    AD-only. Reads the domain object and a few well-known accounts/groups:

      Default password policy (length, history, max age), account lockout
      ms-DS-MachineAccountQuota (who can join computers)
      krbtgt password age, Guest account enabled
      'Pre-Windows 2000 Compatible Access' containing Anonymous / Everyone
      Domain functional level, number of fine-grained password policies
#>

function Invoke-ADAuditDomainPolicyScan {
    [CmdletBinding()]
    param([string]$Server, [pscredential]$Credential, [int]$KrbtgtMaxAgeDays = 180, $Privileged, [int]$AdminMinPasswordLength = 14)

    $nc = Get-ADAuditDefaultNamingContext -Server $Server -Credential $Credential
    $domain = ConvertTo-ADAuditDnsName $nc
    $props = 'objectSid', 'minPwdLength', 'pwdHistoryLength', 'maxPwdAge', 'lockoutThreshold', 'ms-DS-MachineAccountQuota', 'msDS-Behavior-Version'
    $d = Invoke-ADAuditLdapQuery -Server $Server -SearchBase $nc -Credential $Credential -Filter '(objectClass=domainDNS)' -Scope Base -Properties $props | Select-Object -First 1
    $domainSid = ConvertTo-ADAuditSidString $d.objectSid

    function Out-Setting([string]$Setting, $Value, [string]$Severity, [string]$Finding) {
        New-ADAuditResult -Scanner 'DomainPolicy' -Target $domain -Severity $Severity -Finding $Finding -Data ([ordered]@{ Setting = $Setting; Value = $Value })
    }

    $minLen = [int]$d.minPwdLength
    Out-Setting 'MinimumPasswordLength' $minLen $(if ($minLen -lt 8) { 'High' } elseif ($minLen -lt 12) { 'Medium' } else { 'OK' }) $(if ($minLen -lt 12) { "Default policy minimum length is $minLen (recommend 12+ or FGPP)" } else { '' })

    $hist = [int]$d.pwdHistoryLength
    Out-Setting 'PasswordHistoryLength' $hist $(if ($hist -lt 12) { 'Low' } else { 'OK' }) $(if ($hist -lt 12) { "Password history is $hist" } else { '' })

    $maxAgeDays = $null
    if ($null -ne $d.maxPwdAge) {
        $raw = [Int64]"$($d.maxPwdAge)"
        if ($raw -ne 0 -and $raw -ne [Int64]::MinValue) { $maxAgeDays = [int]([math]::Abs($raw) / 864000000000) }
    }
    Out-Setting 'MaximumPasswordAgeDays' $(if ($null -eq $maxAgeDays) { 'Never' } else { $maxAgeDays }) 'Info' ''

    $lock = [int]$d.lockoutThreshold
    Out-Setting 'LockoutThreshold' $lock $(if ($lock -eq 0) { 'Medium' } else { 'OK' }) $(if ($lock -eq 0) { 'No account lockout (password spraying is unthrottled)' } else { '' })

    $maq = $d.'ms-DS-MachineAccountQuota'
    if ($null -ne $maq) {
        $maq = [int]$maq
        Out-Setting 'MachineAccountQuota' $maq $(if ($maq -gt 0) { 'Medium' } else { 'OK' }) $(if ($maq -gt 0) { "Any authenticated user can join up to $maq computers" } else { '' })
    }

    $levels = @{ 0 = '2000'; 1 = '2003 interim'; 2 = '2003'; 3 = '2008'; 4 = '2008 R2'; 5 = '2012'; 6 = '2012 R2'; 7 = '2016'; 10 = '2025' }
    $fl = [int]$d.'msDS-Behavior-Version'
    $flName = $(if ($levels.ContainsKey($fl)) { $levels[$fl] } else { "$fl" })
    Out-Setting 'DomainFunctionalLevel' $flName $(if ($fl -lt 6) { 'Low' } else { 'Info' }) $(if ($fl -lt 6) { "Functional level $flName blocks newer protections (e.g. Protected Users DC-side)" } else { '' })

    # Fine-grained password policies: one row each, and whether admins get a stronger policy
    try {
        $psoProps = 'name', 'msDS-PasswordSettingsPrecedence', 'msDS-MinimumPasswordLength', 'msDS-LockoutThreshold', 'msDS-PasswordReversibleEncryptionEnabled', 'msDS-PSOAppliesTo'
        $pso = @(Invoke-ADAuditLdapQuery -Server $Server -SearchBase "CN=Password Settings Container,CN=System,$nc" -Credential $Credential -Filter '(objectClass=msDS-PasswordSettings)' -Properties $psoProps)
        Out-Setting 'FineGrainedPasswordPolicies' $pso.Count 'Info' $(if ($pso.Count -gt 0) { (($pso | ForEach-Object { $_.name }) -join ', ') } else { 'None (or not readable)' })

        # DNs that make a PSO an "admin" policy: privileged global groups (PSOs only apply via global groups) and privileged accounts
        $adminDns = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
        if ($Privileged) {
            foreach ($g in $Privileged.Groups) { if ($g.Label -in 'Domain Admins', 'Enterprise Admins', 'Schema Admins') { [void]$adminDns.Add($g.DistinguishedName) } }
            foreach ($m in $Privileged.Members) { [void]$adminDns.Add($m.MemberDN) }
        }
        $adminCovered = $false
        foreach ($p in $pso) {
            $applies = @($p.'msDS-PSOAppliesTo' | Where-Object { $_ } | ForEach-Object { [string]$_ })
            $forAdmins = @($applies | Where-Object { $adminDns.Contains($_) }).Count -gt 0
            if ($forAdmins) { $adminCovered = $true }
            $len = [int]$p.'msDS-MinimumPasswordLength'
            $rev = "$($p.'msDS-PasswordReversibleEncryptionEnabled')" -eq 'True'
            $val = 'precedence {0}, min length {1}, lockout {2}, applies to {3}' -f $p.'msDS-PasswordSettingsPrecedence', $len, $p.'msDS-LockoutThreshold', $applies.Count
            if ($rev) { Out-Setting "FGPP:$($p.name)" $val 'High' 'Fine-grained policy enables reversible password encryption' }
            elseif ($forAdmins -and $len -lt $AdminMinPasswordLength) { Out-Setting "FGPP:$($p.name)" $val 'Medium' "Admin fine-grained policy minimum length is $len (recommend $AdminMinPasswordLength+)" }
            else { Out-Setting "FGPP:$($p.name)" $val $(if ($applies.Count -eq 0) { 'Low' } else { 'Info' }) $(if ($applies.Count -eq 0) { 'Fine-grained policy applies to nothing' } elseif ($forAdmins) { 'Applies to admins' } else { '' }) }
        }
        if ($Privileged -and -not $adminCovered -and $minLen -lt $AdminMinPasswordLength) {
            Out-Setting 'AdminPasswordPolicy' "default (min $minLen)" 'Low' "Admins only have the default password policy (min length $minLen) - add a fine-grained policy for admin groups"
        }
    }
    catch { Out-Setting 'FineGrainedPasswordPolicies' $null 'Info' 'Not readable' }

    if ($domainSid) {
        $k = Invoke-ADAuditLdapQuery -Server $Server -SearchBase $nc -Credential $Credential -Filter "(objectSid=$domainSid-502)" -Properties 'pwdLastSet' | Select-Object -First 1
        $kSet = ConvertFrom-ADAuditFileTime $k.pwdLastSet
        if ($kSet) {
            $age = [int]([DateTime]::UtcNow - $kSet).TotalDays
            Out-Setting 'KrbtgtPasswordAgeDays' $age $(if ($age -gt $KrbtgtMaxAgeDays) { 'Medium' } else { 'OK' }) $(if ($age -gt $KrbtgtMaxAgeDays) { "krbtgt password last changed $($kSet.ToString('yyyy-MM-dd'))" } else { '' })
        }

        $g = Invoke-ADAuditLdapQuery -Server $Server -SearchBase $nc -Credential $Credential -Filter "(objectSid=$domainSid-501)" -Properties 'userAccountControl', 'sAMAccountName' | Select-Object -First 1
        if ($g) {
            $enabled = (([int]$g.userAccountControl) -band 0x2) -eq 0
            Out-Setting 'GuestAccountEnabled' $enabled $(if ($enabled) { 'High' } else { 'OK' }) $(if ($enabled) { "Built-in Guest ($($g.sAMAccountName)) is enabled" } else { '' })
        }
    }

    $pre = Invoke-ADAuditLdapQuery -Server $Server -SearchBase $nc -Credential $Credential -Filter '(objectSid=S-1-5-32-554)' -Properties 'member' | Select-Object -First 1
    $members = @($pre.member | Where-Object { $_ })
    $bad = @($members | Where-Object { $_ -match '^CN=(S-1-5-7|S-1-1-0),' })
    $authUsers = @($members | Where-Object { $_ -match '^CN=S-1-5-11,' }).Count -gt 0
    if ($bad.Count -gt 0) { Out-Setting 'PreWindows2000CompatibleAccess' 'Anonymous/Everyone' 'Medium' 'Anonymous or Everyone in Pre-Windows 2000 Compatible Access (anonymous AD enumeration)' }
    else { Out-Setting 'PreWindows2000CompatibleAccess' $(if ($authUsers) { 'Authenticated Users' } else { "$($members.Count) members" }) 'OK' '' }
}
#endregion Scanners/DomainPolicy.ps1

#region Scanners/Events.ps1
<#
    Events
    Reads (never clears or changes) the Security log on each DC for the last
    -EventDays days and reports account, group and directory changes.

      4720/4722/4725/4726/4738/4740/4767/4781  user created/enabled/disabled/deleted/changed/locked/unlocked/renamed
      4724                                     password reset by someone else
      4741                                     computer account created
      4728/4732/4756, 4729/4733/4757           member added to / removed from a security group
      4765/4766                                SID history added / add failed
      4794                                     DSRM administrator password set
      5136 (selected attributes)               SPN, delegation, RBCD, shadow credentials, sIDHistory,
                                               ACL on AdminSDHolder / domain root, gPLink, scriptPath

    Fields are read from the event XML by name, so it works on any DC language.
    4738 is only reported when a security-relevant field changed (UAC flags,
    delegation, SID history, primary group, logon script).

    Needs: membership of 'Event Log Readers' on DCs (or Domain Admins), remote
    event log access (RPC, TCP 135 + dynamic), and the matching audit subcategories
    enabled (see the AuditPolicy scanner). 5136 also needs SACLs on the objects.
#>

# SAM account-control bits as used by 4720/4738 (OldUacValue / NewUacValue)
$script:ADAuditSamUacBits = @(
    'Account Disabled', 'Home Directory Required', 'Password Not Required', 'Temp Duplicate Account', 'Normal Account',
    'MNS Logon Account', 'Interdomain Trust Account', 'Workstation Trust Account', 'Server Trust Account', "Don't Expire Password",
    'Account Locked', 'Encrypted Text Password Allowed', 'Smartcard Required', 'Trusted For Delegation', 'Not Delegated',
    'Use DES Key Only', "Don't Require Preauth", 'Password Expired', 'Trusted To Authenticate For Delegation', 'No Auth Data Required'
)
$script:ADAuditUacEnableSeverity = @{
    'Trusted For Delegation' = 'High'; "Don't Require Preauth" = 'High'; 'Password Not Required' = 'Medium'
    'Use DES Key Only' = 'Medium'; 'Trusted To Authenticate For Delegation' = 'Medium'; "Don't Expire Password" = 'Low'
    'Encrypted Text Password Allowed' = 'High'
}
$script:ADAuditUacDisableSeverity = @{ 'Smartcard Required' = 'Low'; 'Not Delegated' = 'Medium' }

$script:ADAuditEventNames = @{
    4720 = 'User account created'; 4722 = 'User account enabled'; 4724 = 'Password reset'; 4725 = 'User account disabled'
    4726 = 'User account deleted'; 4738 = 'User account changed'; 4740 = 'Account locked out'; 4741 = 'Computer account created'
    4767 = 'Account unlocked'; 4781 = 'Account renamed'; 4728 = 'Added to global group'; 4729 = 'Removed from global group'
    4732 = 'Added to local group'; 4733 = 'Removed from local group'; 4756 = 'Added to universal group'; 4757 = 'Removed from universal group'
    4765 = 'SID history added'; 4766 = 'SID history add failed'; 4794 = 'DSRM password set'; 5136 = 'Directory object modified'
}

$script:ADAudit5136Attributes = @(
    'servicePrincipalName', 'msDS-AllowedToDelegateTo', 'msDS-AllowedToActOnBehalfOfOtherIdentity',
    'msDS-KeyCredentialLink', 'sIDHistory', 'nTSecurityDescriptor', 'gPLink', 'scriptPath', 'userAccountControl'
)

function Get-ADAuditEventQueryXml {
    param([int]$Days)
    $ms = [int64]$Days * 86400000
    $ids = (@(4720, 4722, 4724, 4725, 4726, 4738, 4740, 4741, 4767, 4781, 4728, 4729, 4732, 4733, 4756, 4757, 4765, 4766, 4794) | ForEach-Object { "EventID=$_" }) -join ' or '
    $attrs = ($script:ADAudit5136Attributes | ForEach-Object { "Data[@Name='AttributeLDAPDisplayName']='$_'" }) -join ' or '
    return @"
<QueryList>
  <Query Id="0" Path="Security">
    <Select Path="Security">*[System[($ids) and TimeCreated[timediff(@SystemTime) &lt;= $ms]]]</Select>
    <Select Path="Security">*[System[EventID=5136 and TimeCreated[timediff(@SystemTime) &lt;= $ms]]] and *[EventData[$attrs]]</Select>
  </Query>
</QueryList>
"@
}

function ConvertFrom-ADAuditEventXml {
    param([Parameter(Mandatory)][string]$Xml)
    $x = [xml]$Xml
    $d = @{}
    foreach ($n in $x.Event.EventData.Data) { if ($n.Name) { $d[[string]$n.Name] = [string]$n.'#text' } }
    return $d
}

function Get-ADAuditUacChange {
    param([string]$Old, [string]$New)
    try { $o = [Convert]::ToInt64(($Old -replace '^0x', ''), 16); $n = [Convert]::ToInt64(($New -replace '^0x', ''), 16) } catch { return $null }
    $on = @(); $off = @()
    for ($i = 0; $i -lt $script:ADAuditSamUacBits.Count; $i++) {
        $bit = [int64]1 -shl $i
        if ((($n -band $bit) -ne 0) -and (($o -band $bit) -eq 0)) { $on += $script:ADAuditSamUacBits[$i] }
        if ((($o -band $bit) -ne 0) -and (($n -band $bit) -eq 0)) { $off += $script:ADAuditSamUacBits[$i] }
    }
    [pscustomobject]@{ Enabled = $on; Disabled = $off }
}

function Get-ADAuditUsefulValue {
    param([string]$Value)
    if (-not $Value -or $Value -eq '-' -or $Value -match '^%%1793$') { return $null }   # %%1793 = <value not set>
    return $Value
}

function ConvertTo-ADAuditEventResult {
    <#
        Turns one event (id, time, dc, data hashtable) into a result row, or $null
        when the event is not interesting (e.g. a 4738 with no security-relevant change).
    #>
    param(
        [Parameter(Mandatory)][int]$Id,
        [Parameter(Mandatory)][datetime]$TimeCreated,
        [Parameter(Mandatory)][string]$DC,
        [Parameter(Mandatory)][hashtable]$D,
        [hashtable]$PrivilegedSids = @{},
        [hashtable]$PrivilegedNames = @{},
        [string]$DomainDN
    )

    $actor = $(if ($D['SubjectUserName'] -and $D['SubjectUserName'] -ne '-') { "$($D['SubjectDomainName'])\$($D['SubjectUserName'])" } else { $null })
    $target = $(if ($D['TargetUserName']) { "$($D['TargetDomainName'])\$($D['TargetUserName'])".TrimStart('\') } else { $null })
    $action = $script:ADAuditEventNames[$Id]
    $sev = 'Info'; $detail = ''; $group = $null; $member = $null

    $isPrivTarget = ($D['TargetSid'] -and $PrivilegedSids.ContainsKey($D['TargetSid'])) -or ($D['TargetUserName'] -and $PrivilegedNames.ContainsKey($D['TargetUserName']))

    switch ($Id) {
        { $_ -in 4728, 4732, 4756 } {
            $group = $target; $member = $(if ($D['MemberName'] -and $D['MemberName'] -ne '-') { $D['MemberName'] } else { $D['MemberSid'] })
            $target = $member
            if ($D['TargetSid'] -and $PrivilegedSids.ContainsKey($D['TargetSid'])) { $sev = 'High'; $detail = "Added to privileged group $group" }
            else { $detail = "Added to $group" }
        }
        { $_ -in 4729, 4733, 4757 } {
            $group = $target; $member = $(if ($D['MemberName'] -and $D['MemberName'] -ne '-') { $D['MemberName'] } else { $D['MemberSid'] })
            $target = $member
            if ($D['TargetSid'] -and $PrivilegedSids.ContainsKey($D['TargetSid'])) { $sev = 'Medium'; $detail = "Removed from privileged group $group" }
            else { $detail = "Removed from $group" }
        }
        4720 { $detail = 'New user account' }
        4741 { $detail = "New computer account (created by $actor)" }
        4726 { $sev = 'Low'; $detail = 'User account deleted' }
        4724 { if ($isPrivTarget) { $sev = 'Medium'; $detail = 'Password of a privileged account reset by another account' } else { $detail = 'Password reset by another account' } }
        4740 { $detail = "Locked out (caller computer: $($D['TargetDomainName']))"; $target = $D['TargetUserName'] }
        4781 { $sev = 'Low'; $target = $D['NewTargetUserName']; $detail = "Renamed from $($D['OldTargetUserName']) to $($D['NewTargetUserName'])" }
        4765 { $sev = 'High'; $detail = "SID history added (source: $($D['SourceUserName']), SIDs: $($D['SidList']))" }
        4766 { $sev = 'Medium'; $detail = "SID history add failed (source: $($D['SourceUserName']))" }
        4794 { $sev = 'High'; $target = $DC; $detail = "DSRM administrator password set from $($D['Workstation']) (status $($D['Status']))" }
        4738 {
            $parts = @(); $sevs = @()
            $uac = Get-ADAuditUacChange -Old $D['OldUacValue'] -New $D['NewUacValue']
            if ($uac) {
                foreach ($f in $uac.Enabled) {
                    if ($script:ADAuditUacEnableSeverity.ContainsKey($f)) { $parts += "$f enabled"; $sevs += $script:ADAuditUacEnableSeverity[$f] }
                }
                foreach ($f in $uac.Disabled) {
                    if ($script:ADAuditUacDisableSeverity.ContainsKey($f)) { $parts += "$f disabled"; $sevs += $script:ADAuditUacDisableSeverity[$f] }
                }
            }
            if (Get-ADAuditUsefulValue $D['AllowedToDelegateTo']) { $parts += "Delegation set to $($D['AllowedToDelegateTo'])"; $sevs += 'Medium' }
            if (Get-ADAuditUsefulValue $D['SidHistory']) { $parts += 'SID history changed'; $sevs += 'High' }
            if (Get-ADAuditUsefulValue $D['PrimaryGroupId']) { $parts += "Primary group changed to RID $($D['PrimaryGroupId'])"; $sevs += 'Medium' }
            if (Get-ADAuditUsefulValue $D['ScriptPath']) { $parts += "Logon script set to $($D['ScriptPath'])"; $sevs += 'Low' }
            if ($parts.Count -eq 0) { return $null }
            if ($isPrivTarget) { $sevs += 'Medium' }
            $sev = Get-ADAuditMaxSeverity $sevs
            $detail = $parts -join '; '
        }
        5136 {
            $attr = $D['AttributeLDAPDisplayName']
            $op = switch ($D['OperationType']) { '%%14674' { 'added' } '%%14675' { 'removed' } default { 'changed' } }
            $obj = $D['ObjectDN']; $class = $D['ObjectClass']
            $target = $obj
            $val = [string]$D['AttributeValue']
            if ($val.Length -gt 200) { $val = $val.Substring(0, 200) + '...' }
            $isRoot = $DomainDN -and ($obj -ieq $DomainDN)
            $isAdminSd = $obj -match '^CN=AdminSDHolder,CN=System,'
            switch ($attr) {
                'msDS-KeyCredentialLink' { $sev = $(if ($op -eq 'added' -and $class -ne 'computer') { 'High' } elseif ($op -eq 'added') { 'Medium' } else { 'Info' }); $detail = "Key credential $op (shadow credentials if unexpected)" }
                'msDS-AllowedToActOnBehalfOfOtherIdentity' { $sev = $(if ($op -eq 'added') { 'High' } else { 'Info' }); $detail = "Resource-based constrained delegation $op" }
                'msDS-AllowedToDelegateTo' { $sev = $(if ($op -eq 'added') { 'Medium' } else { 'Info' }); $detail = "Constrained delegation target $op`: $val" }
                'servicePrincipalName' { $sev = $(if ($op -eq 'added' -and $class -eq 'user') { 'Medium' } else { 'Info' }); $detail = "SPN $op on $class`: $val" }
                'sIDHistory' { $sev = $(if ($op -eq 'added') { 'High' } else { 'Info' }); $detail = "sIDHistory $op" }
                'nTSecurityDescriptor' {
                    if ($op -eq 'removed') { return $null }   # every ACL change logs remove-old + add-new; keep the add
                    $sev = $(if ($isAdminSd -or $isRoot) { 'High' } else { 'Low' })
                    $detail = $(if ($isAdminSd) { 'ACL changed on AdminSDHolder (persists to all protected accounts)' } elseif ($isRoot) { 'ACL changed on domain root (DCSync rights?)' } else { "ACL changed on $class" })
                }
                'gPLink' { if ($op -eq 'removed') { return $null }; $sev = 'Low'; $detail = "GPO links changed on $class" }
                'scriptPath' { if ($op -eq 'removed') { return $null }; $sev = 'Low'; $detail = "Logon script set: $val" }
                'userAccountControl' {
                    if ($op -ne 'added' -or $class -ne 'computer') { return $null }   # users are covered by 4738
                    $v = 0; [void][int]::TryParse($D['AttributeValue'], [ref]$v)
                    if ($v -band 0x80000) { $sev = 'High'; $detail = 'Computer trusted for unconstrained delegation' }
                    elseif ($v -band 0x1000000) { $sev = 'Medium'; $detail = 'Computer trusted to authenticate for delegation' }
                    else { return $null }
                }
            }
            $action = "Attribute $attr $op"
        }
    }

    New-ADAuditResult -Scanner 'Events' -Target $(if ($target) { $target } else { '(unknown)' }) -Severity $sev -Finding $detail -Data ([ordered]@{
        Check       = 'Event'
        TimeCreated = $TimeCreated
        DC          = $DC
        EventId     = $Id
        Action      = $action
        Actor       = $actor
        Group       = $group
    })
}

function Invoke-ADAuditEventScan {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$ComputerName,
        [int]$EventDays = 7,
        [int]$MaxEvents = 5000,
        [hashtable]$PrivilegedSids = @{},
        [hashtable]$PrivilegedNames = @{},
        [string]$DomainDN,
        [int]$TimeoutMs = 3000
    )

    if (-not (Test-ADAuditTcpPort -ComputerName $ComputerName -Port 135 -TimeoutMs $TimeoutMs)) {
        New-ADAuditResult -Scanner 'Events' -Target $ComputerName -Severity 'Info' -Finding 'TCP 135 (RPC) not reachable; Security log not read' -Data ([ordered]@{ Check = 'Coverage'; DC = $ComputerName })
        return
    }

    # How far back does the Security log actually go?
    $oldest = $null
    try {
        $o = Get-WinEvent -ComputerName $ComputerName -LogName Security -Oldest -MaxEvents 1 -ErrorAction Stop
        $oldest = $o.TimeCreated
    }
    catch [System.UnauthorizedAccessException] {
        New-ADAuditResult -Scanner 'Events' -Target $ComputerName -Severity 'Error' -Finding "Access denied reading Security log - add the scanning account to 'Event Log Readers' on DCs" -Data ([ordered]@{ Check = 'Coverage'; DC = $ComputerName })
        return
    }
    catch {
        New-ADAuditResult -Scanner 'Events' -Target $ComputerName -Severity 'Error' -Finding "Could not read Security log: $($_.Exception.Message)" -Data ([ordered]@{ Check = 'Coverage'; DC = $ComputerName })
        return
    }

    $events = @()
    $truncated = $false
    try {
        $events = @(Get-WinEvent -ComputerName $ComputerName -FilterXml ([xml](Get-ADAuditEventQueryXml -Days $EventDays)) -MaxEvents $MaxEvents -ErrorAction Stop)
        $truncated = $events.Count -ge $MaxEvents
    }
    catch {
        if ($_.FullyQualifiedErrorId -notlike 'NoMatchingEventsFound*') {
            New-ADAuditResult -Scanner 'Events' -Target $ComputerName -Severity 'Error' -Finding "Event query failed: $($_.Exception.Message)" -Data ([ordered]@{ Check = 'Coverage'; DC = $ComputerName })
            return
        }
    }

    $reported = 0
    foreach ($e in $events) {
        try {
            $r = ConvertTo-ADAuditEventResult -Id $e.Id -TimeCreated $e.TimeCreated -DC $ComputerName -D (ConvertFrom-ADAuditEventXml $e.ToXml()) -PrivilegedSids $PrivilegedSids -PrivilegedNames $PrivilegedNames -DomainDN $DomainDN
            if ($r) { $reported++; $r }
        }
        catch { New-ADAuditResult -Scanner 'Events' -Target $ComputerName -Severity 'Error' -Finding "Could not parse event $($e.Id) record $($e.RecordId): $($_.Exception.Message)" -Data ([ordered]@{ Check = 'Event'; DC = $ComputerName }) }
    }

    $windowStart = (Get-Date).AddDays(-$EventDays)
    $sev = 'OK'; $notes = @()
    if ($oldest -and $oldest -gt $windowStart) {
        $hours = [int]((Get-Date) - $oldest).TotalHours
        $sev = $(if ($hours -lt 24) { 'Medium' } else { 'Low' })
        $notes += "Security log only covers the last $hours hours (oldest event $($oldest.ToString('yyyy-MM-dd HH:mm'))) - increase its size or forward to SIEM"
    }
    if ($truncated) { $notes += "Hit -MaxEvents $MaxEvents; older matching events not reviewed"; $sev = Get-ADAuditMaxSeverity @($sev, 'Info') }
    $notes = @("$($events.Count) matching events, $reported reported") + $notes

    New-ADAuditResult -Scanner 'Events' -Target $ComputerName -Severity $sev -Finding ($notes -join '; ') -Data ([ordered]@{
        Check = 'Coverage'; DC = $ComputerName; OldestEvent = $oldest; WindowDays = $EventDays
    })
}
#endregion Scanners/Events.ps1

#region Scanners/Groups.ps1
<#
    Groups (PingCastle equivalents: privileged group checks, nested group findings)
    AD-only. Reads group objects and uses LDAP_MATCHING_RULE_IN_CHAIN to resolve
    direct AND nested members of privileged groups.

    Reports:
      - Every member of each privileged group (direct or nested)
      - Computers / foreign principals / disabled accounts inside privileged groups
      - Operator groups and Schema/Enterprise Admins that are not empty
      - Groups nested deeper than -MaxNestingDepth, and circular nesting
      - Hidden membership via primaryGroupID (never shown in memberOf)
      - More than -MaxDomainAdmins enabled users in Domain/Enterprise Admins or Administrators
      - Empty groups and empty OUs (hygiene, Info)
#>

function Get-ADAuditGroupInventory {
    param([string]$Server, [string]$SearchBase, [pscredential]$Credential)
    $props = 'distinguishedName', 'sAMAccountName', 'objectSid', 'memberOf', 'adminCount', 'groupType'
    foreach ($g in (Invoke-ADAuditLdapQuery -Server $Server -SearchBase $SearchBase -Credential $Credential -Filter '(objectCategory=group)' -Properties $props)) {
        [pscustomobject]@{
            DistinguishedName = [string]$g.distinguishedName
            SamAccountName    = [string]$g.sAMAccountName
            Sid               = ConvertTo-ADAuditSidString $g.objectSid
            MemberOf          = @($g.memberOf | Where-Object { $_ } | ForEach-Object { [string]$_ })
            AdminCount        = $g.adminCount
        }
    }
}

function Get-ADAuditPrivilegedMembership {
    <#
        Returns:
          Groups         - privileged group objects found in this domain (with .Label)
          Members        - one row per (group, member), Direct = $true/$false
          MapByMember    - DN -> list of privileged group labels
          ProtectedUsers - HashSet of DNs in Protected Users (incl. nested)
          Sids           - HashSet of SIDs of privileged groups and their members
        Primary-group membership (primaryGroupID = 512 etc.) is included: it never
        shows in memberOf or in LDAP_MATCHING_RULE_IN_CHAIN results.
    #>
    param([Parameter(Mandatory)][object[]]$Groups, [string]$Server, [string]$SearchBase, [pscredential]$Credential)

    $builtin = @{ 'S-1-5-32-544' = 'Administrators'; 'S-1-5-32-548' = 'Account Operators'; 'S-1-5-32-549' = 'Server Operators'; 'S-1-5-32-550' = 'Print Operators'; 'S-1-5-32-551' = 'Backup Operators' }
    $domainRids = @{ '512' = 'Domain Admins'; '518' = 'Schema Admins'; '519' = 'Enterprise Admins'; '520' = 'Group Policy Creator Owners'; '526' = 'Key Admins'; '527' = 'Enterprise Key Admins' }

    $privGroups = @()
    $protectedGroup = $null
    foreach ($g in $Groups) {
        $label = $null
        if ($g.Sid -and $builtin.ContainsKey($g.Sid)) { $label = $builtin[$g.Sid] }
        elseif ($g.Sid -match '^S-1-5-21-.+-(\d+)$') {
            $rid = $Matches[1]
            if ($domainRids.ContainsKey($rid)) { $label = $domainRids[$rid] }
            elseif ($rid -eq '525') { $protectedGroup = $g }
        }
        if (-not $label -and $g.SamAccountName -eq 'DnsAdmins') { $label = 'DnsAdmins' }
        if ($label) { $privGroups += ($g | Select-Object *, @{ n = 'Label'; e = { $label } }) }
    }

    $memberProps = 'distinguishedName', 'sAMAccountName', 'objectClass', 'memberOf', 'userAccountControl', 'objectSid'
    $rows = New-Object System.Collections.ArrayList
    $map = @{}
    $sids = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    foreach ($pg in $privGroups) {
        if ($pg.Sid) { [void]$sids.Add($pg.Sid) }
        $queries = @(@{ Filter = ('(memberOf:1.2.840.113556.1.4.1941:={0})' -f (ConvertTo-ADAuditLdapFilterValue $pg.DistinguishedName)); Primary = $false })
        if ($pg.Sid -match '^S-1-5-21-.+-(\d+)$') { $queries += @{ Filter = "(primaryGroupID=$($Matches[1]))"; Primary = $true } }
        $seen = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
        foreach ($q in $queries) {
            foreach ($m in (Invoke-ADAuditLdapQuery -Server $Server -SearchBase $SearchBase -Credential $Credential -Filter $q.Filter -Properties $memberProps)) {
                $dn = [string]$m.distinguishedName
                if (-not $seen.Add($dn)) { continue }
                $classes = @($m.objectClass)
                $class = [string]$classes[-1]
                $direct = (-not $q.Primary) -and (@($m.memberOf | Where-Object { $_ -and ([string]$_ -ieq $pg.DistinguishedName) }).Count -gt 0)
                $uac = 0; if ($null -ne $m.userAccountControl) { $uac = [int]$m.userAccountControl }
                $sid = ConvertTo-ADAuditSidString $m.objectSid
                if ($sid) { [void]$sids.Add($sid) }
                [void]$rows.Add([pscustomobject]@{
                    GroupLabel   = $pg.Label
                    GroupDN      = $pg.DistinguishedName
                    MemberDN     = $dn
                    MemberName   = $(if ($m.sAMAccountName) { [string]$m.sAMAccountName } else { ($dn -split ',')[0] -replace '^CN=', '' })
                    MemberSid    = $sid
                    MemberType   = $class
                    Direct       = $direct
                    PrimaryGroup = $q.Primary
                    Disabled     = (($uac -band 0x2) -ne 0)
                    UAC          = $uac
                })
                if (-not $map.ContainsKey($dn)) { $map[$dn] = New-Object System.Collections.Generic.List[string] }
                if (-not $map[$dn].Contains($pg.Label)) { $map[$dn].Add($pg.Label) }
            }
        }
    }

    $protected = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    if ($protectedGroup) {
        $f = '(memberOf:1.2.840.113556.1.4.1941:={0})' -f (ConvertTo-ADAuditLdapFilterValue $protectedGroup.DistinguishedName)
        foreach ($m in (Invoke-ADAuditLdapQuery -Server $Server -SearchBase $SearchBase -Credential $Credential -Filter $f -Properties 'distinguishedName')) {
            [void]$protected.Add([string]$m.distinguishedName)
        }
    }

    [pscustomobject]@{ Groups = $privGroups; Members = @($rows); MapByMember = $map; ProtectedUsers = $protected; Sids = $sids }
}

function Get-ADAuditGroupDepth {
    # $Visiting is the current DFS path (List[string]); every group on a loop is added to $Cycles
    param($Dn, $Parents, $Memo, $Visiting, $Cycles)
    if ($Memo.ContainsKey($Dn)) { return $Memo[$Dn] }
    $idx = -1
    for ($i = 0; $i -lt $Visiting.Count; $i++) { if ($Visiting[$i] -ieq $Dn) { $idx = $i; break } }
    if ($idx -ge 0) {
        for ($i = $idx; $i -lt $Visiting.Count; $i++) { [void]$Cycles.Add($Visiting[$i]) }
        return 0
    }
    $Visiting.Add($Dn)
    $max = 0
    foreach ($p in $Parents[$Dn]) {
        if ($p -and $Parents.ContainsKey($p)) {
            $d = 1 + (Get-ADAuditGroupDepth -Dn $p -Parents $Parents -Memo $Memo -Visiting $Visiting -Cycles $Cycles)
            if ($d -gt $max) { $max = $d }
        }
    }
    $Visiting.RemoveAt($Visiting.Count - 1)
    $Memo[$Dn] = $max
    return $max
}

function Invoke-ADAuditGroupScan {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][object[]]$Groups,
        [Parameter(Mandatory)]$Privileged,
        [int]$MaxNestingDepth = 3,
        [int]$MaxDomainAdmins = 5,
        [string]$Server,
        [string]$SearchBase,
        [pscredential]$Credential,
        [switch]$SkipHygiene
    )

    $shouldBeEmpty = @('Account Operators', 'Server Operators', 'Print Operators', 'Schema Admins', 'Enterprise Admins')

    # ---- Privileged groups: summary + members ----
    foreach ($pg in $Privileged.Groups) {
        $members = @($Privileged.Members | Where-Object { $_.GroupDN -eq $pg.DistinguishedName })
        $users = @($members | Where-Object { $_.MemberType -in 'user', 'inetOrgPerson' })
        $sev = 'Info'
        $finding = '{0} members ({1} direct, {2} users)' -f $members.Count, @($members | Where-Object { $_.Direct }).Count, $users.Count
        if ($members.Count -gt 0 -and $shouldBeEmpty -contains $pg.Label) {
            $sev = $(if ($pg.Label -like '*Operators') { 'Medium' } else { 'Low' })
            $finding += ' - this group should normally be empty'
        }
        New-ADAuditResult -Scanner 'Groups' -Target $pg.Label -Severity $sev -Finding $finding -Data ([ordered]@{
            Check = 'PrivilegedGroup'; Group = $pg.Label; Member = $null; MemberType = $null; Membership = $null; Disabled = $null; NestingDepth = $null; DistinguishedName = $pg.DistinguishedName
        })

        if ($pg.Label -in 'Domain Admins', 'Enterprise Admins', 'Administrators') {
            $enabledUsers = @($users | Where-Object { -not $_.Disabled } | Select-Object -ExpandProperty MemberDN -Unique)
            if ($enabledUsers.Count -gt $MaxDomainAdmins) {
                New-ADAuditResult -Scanner 'Groups' -Target $pg.Label -Severity 'Medium' -Finding "Too many admins: $($enabledUsers.Count) enabled users (limit $MaxDomainAdmins)" -Data ([ordered]@{
                    Check = 'AdminCount'; Group = $pg.Label; DistinguishedName = $pg.DistinguishedName
                })
            }
        }

        foreach ($m in $members) {
            $sev = 'Info'; $finding = 'Privileged group member'
            switch ($m.MemberType) {
                'computer' {
                    if (($m.UAC -band 0x2000) -eq 0) { $sev = 'High'; $finding = 'Computer account in privileged group' }
                }
                'foreignSecurityPrincipal' { $sev = 'Medium'; $finding = 'Foreign (cross-trust) principal in privileged group' }
                'group' { $finding = 'Group nested inside privileged group' }
                'msDS-GroupManagedServiceAccount' { $sev = 'Low'; $finding = 'gMSA in privileged group - confirm it needs this' }
            }
            if ($m.Disabled -and $m.MemberType -in 'user', 'inetOrgPerson', 'computer') { $sev = 'Low'; $finding = 'Disabled account still in privileged group' }
            if ($m.PrimaryGroup) { $sev = 'High'; $finding = 'Hidden membership via primaryGroupID (not visible in member/memberOf)' }

            New-ADAuditResult -Scanner 'Groups' -Target $m.MemberName -Severity $sev -Finding $finding -Data ([ordered]@{
                Check = 'PrivilegedMember'; Group = $pg.Label; Member = $m.MemberName; MemberType = $m.MemberType
                Membership = $(if ($m.PrimaryGroup) { 'PrimaryGroup' } elseif ($m.Direct) { 'Direct' } else { 'Nested' }); Disabled = $m.Disabled; NestingDepth = $null; DistinguishedName = $m.MemberDN
            })
        }
    }

    # ---- Nesting depth and cycles ----
    $parents = @{}
    foreach ($g in $Groups) { $parents[$g.DistinguishedName] = $g.MemberOf }
    $memo = @{}
    $visiting = New-Object 'System.Collections.Generic.List[string]'
    $cycles = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    foreach ($g in $Groups) { [void](Get-ADAuditGroupDepth -Dn $g.DistinguishedName -Parents $parents -Memo $memo -Visiting $visiting -Cycles $cycles) }

    foreach ($g in $Groups) {
        $depth = $memo[$g.DistinguishedName]
        $inCycle = $cycles.Contains($g.DistinguishedName)
        if ($inCycle) {
            $sev = 'Medium'; $finding = 'Circular group nesting'
        }
        elseif ($depth -gt $MaxNestingDepth) {
            $sev = 'Low'; $finding = "Nested $depth levels deep (limit $MaxNestingDepth)"
        }
        else { continue }
        New-ADAuditResult -Scanner 'Groups' -Target $g.SamAccountName -Severity $sev -Finding $finding -Data ([ordered]@{
            Check = 'Nesting'; Group = $g.SamAccountName; Member = $null; MemberType = 'group'; Membership = $null; Disabled = $null; NestingDepth = $depth; DistinguishedName = $g.DistinguishedName
        })
    }

    if ($SkipHygiene) { return }

    # ---- Empty groups (custom groups only: RID >= 1000, not in CN=Builtin) ----
    try {
        $primaryInUse = New-Object 'System.Collections.Generic.HashSet[string]'
        $pf = '(&(|(objectCategory=person)(objectCategory=computer))(!(primaryGroupID=513))(!(primaryGroupID=514))(!(primaryGroupID=515))(!(primaryGroupID=516))(!(primaryGroupID=521)))'
        foreach ($o in (Invoke-ADAuditLdapQuery -Server $Server -SearchBase $SearchBase -Credential $Credential -Filter $pf -Properties 'primaryGroupID')) { if ($o.primaryGroupID) { [void]$primaryInUse.Add([string]$o.primaryGroupID) } }

        foreach ($g in (Invoke-ADAuditLdapQuery -Server $Server -SearchBase $SearchBase -Credential $Credential -Filter '(&(objectCategory=group)(!(member=*)))' -Properties 'distinguishedName', 'sAMAccountName', 'objectSid', 'whenCreated')) {
            $dn = [string]$g.distinguishedName
            $sid = ConvertTo-ADAuditSidString $g.objectSid
            if ($dn -match ',CN=Builtin,') { continue }
            if (-not ($sid -match '-(\d+)$') -or [int64]$Matches[1] -lt 1000) { continue }
            if ($primaryInUse.Contains($Matches[1])) { continue }
            New-ADAuditResult -Scanner 'Groups' -Target ([string]$g.sAMAccountName) -Severity 'Info' -Finding 'Empty group (no members; probably unused)' -Data ([ordered]@{
                Check = 'EmptyGroup'; Group = [string]$g.sAMAccountName; DistinguishedName = $dn
            })
        }
    }
    catch { New-ADAuditResult -Scanner 'Groups' -Target '(empty groups)' -Severity 'Error' -Finding $_.Exception.Message -Data ([ordered]@{ Check = 'EmptyGroup' }) }

    # ---- Empty OUs ----
    try {
        $ous = @(Invoke-ADAuditLdapQuery -Server $Server -SearchBase $SearchBase -Credential $Credential -Filter '(objectCategory=organizationalUnit)' -Properties 'distinguishedName', 'name')
        if ($ous.Count -gt 5000) {
            New-ADAuditResult -Scanner 'Groups' -Target '(empty OUs)' -Severity 'Info' -Finding "Skipped empty-OU check: $($ous.Count) OUs" -Data ([ordered]@{ Check = 'EmptyOU' })
        }
        else {
            foreach ($ou in $ous) {
                $dn = [string]$ou.distinguishedName
                if ($dn -match '^OU=Domain Controllers,') { continue }
                $child = @(Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase $dn -Scope OneLevel -Filter '(objectClass=*)' -Properties 'distinguishedName' -SizeLimit 1)
                if ($child.Count -eq 0) {
                    New-ADAuditResult -Scanner 'Groups' -Target ([string]$ou.name) -Severity 'Info' -Finding 'Empty OU (no child objects)' -Data ([ordered]@{ Check = 'EmptyOU'; DistinguishedName = $dn })
                }
            }
        }
    }
    catch { New-ADAuditResult -Scanner 'Groups' -Target '(empty OUs)' -Severity 'Error' -Finding $_.Exception.Message -Data ([ordered]@{ Check = 'EmptyOU' }) }
}
#endregion Scanners/Groups.ps1

#region Scanners/LapsBitLocker.ps1
<#
    LapsBitLocker (PingCastle equivalent: laps_bitlocker)
    AD-only. For each enabled computer, checks:
      - Legacy LAPS:  ms-Mcs-AdmPwdExpirationTime
      - Windows LAPS: msLAPS-PasswordExpirationTime
      - BitLocker:    msFVE-RecoveryInformation child objects
    Only expiration timestamps and object existence are read - never passwords
    or recovery keys. Nothing is sent to the computers themselves.

    Permissions note: BitLocker recovery objects are normally visible only to
    Domain Admins (or delegated readers). If none are visible at all, the scanner
    reports BitLocker as 'NotVisible' instead of flagging every computer.
#>

function Invoke-ADAuditLapsBitLocker {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][object[]]$Computers,
        [string]$Server,
        [string]$SearchBase,
        [pscredential]$Credential
    )

    $filter = '(&(objectCategory=computer)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))'
    $lapsProps = 'distinguishedName', 'ms-Mcs-AdmPwdExpirationTime', 'msLAPS-PasswordExpirationTime'
    $laps = @{}
    foreach ($r in (Invoke-ADAuditLdapQuery -Server $Server -SearchBase $SearchBase -Credential $Credential -Filter $filter -Properties $lapsProps)) {
        $laps[[string]$r.distinguishedName] = $r
    }

    $bitlocker = @{}
    $blNote = $null
    try {
        foreach ($r in (Invoke-ADAuditLdapQuery -Server $Server -SearchBase $SearchBase -Credential $Credential -Filter '(objectClass=msFVE-RecoveryInformation)' -Properties 'distinguishedName')) {
            # Parent DN = strip the first (unescaped) RDN
            $parent = ([string]$r.distinguishedName) -replace '^(?:[^,\\]|\\.)*,', ''
            $bitlocker[$parent] = 1 + [int]$bitlocker[$parent]
        }
    }
    catch { $blNote = "BitLocker query failed: $($_.Exception.Message)" }
    $blVisible = $bitlocker.Count -gt 0
    if (-not $blVisible -and -not $blNote) { $blNote = 'No recovery objects visible (none escrowed, or no read permission)' }

    $now = [DateTime]::UtcNow
    foreach ($c in $Computers) {
        $row = $laps[$c.DistinguishedName]
        $legacyExp = $null; $winExp = $null
        if ($row) {
            $legacyExp = ConvertFrom-ADAuditFileTime $row.'ms-Mcs-AdmPwdExpirationTime'
            $winExp = ConvertFrom-ADAuditFileTime $row.'msLAPS-PasswordExpirationTime'
        }
        $lapsType = @()
        if ($legacyExp) { $lapsType += 'Legacy' }
        if ($winExp) { $lapsType += 'Windows' }
        $expiry = @($legacyExp, $winExp) | Where-Object { $_ } | Sort-Object -Descending | Select-Object -First 1

        $blCount = [int]$bitlocker[$c.DistinguishedName]
        $blStatus = $(if (-not $blVisible) { 'NotVisible' } elseif ($blCount -gt 0) { 'Escrowed' } else { 'None' })

        $issues = @(); $sev = @()
        if ($c.IsDomainController) {
            $lapsStatus = 'N/A (DC)'
        }
        elseif (-not $lapsType) {
            $lapsStatus = 'None'
            $issues += 'No LAPS-managed local admin password'
            $sev += 'Medium'
        }
        elseif ($expiry -lt $now.AddDays(-7)) {
            $lapsStatus = 'Expired'
            $issues += "LAPS password past expiry since $($expiry.ToString('yyyy-MM-dd')) (not rotating)"
            $sev += 'Low'
        }
        else { $lapsStatus = 'OK' }

        if ($blStatus -eq 'None' -and -not $c.IsStale) {
            $issues += 'No BitLocker recovery key escrowed in AD'
            $sev += 'Low'
        }

        New-ADAuditResult -Scanner 'LapsBitLocker' -Computer $c.Name -Severity (Get-ADAuditMaxSeverity $sev) -Finding ($issues -join '; ') -Data ([ordered]@{
            DnsHostName          = $c.DnsHostName
            IsDomainController   = $c.IsDomainController
            OperatingSystem      = $c.OperatingSystem
            LapsStatus           = $lapsStatus
            LapsType             = ($lapsType -join '+')
            LapsExpiryUtc        = $expiry
            BitLockerStatus      = $blStatus
            BitLockerRecoveryObj = $(if ($blVisible) { $blCount } else { $null })
            IsStale              = $c.IsStale
            Note                 = $(if (-not $blVisible) { $blNote } else { $null })
            IssueSeverity = (@($sev) -join ';')
        })
    }
}
#endregion Scanners/LapsBitLocker.ps1

#region Scanners/LocalAdmin.ps1
<#
    LocalAdmin (PingCastle equivalent: localadmin)
    Lists members of BUILTIN\Administrators (S-1-5-32-544) on each host via
    NetLocalGroupGetMembers - a read-only SAMR query.

    Windows 10 1607+ / Server 2016+ restrict remote SAM enumeration to local admins
    by default (RestrictRemoteSAM), so a non-admin scanning account will mostly get
    'Access denied'. Run as an account with local admin rights for full coverage.
#>

function Invoke-ADAuditLocalAdminScan {
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$ComputerName)

    $sidUsageNames = @{ 1 = 'User'; 2 = 'Group'; 3 = 'Domain'; 4 = 'Alias'; 5 = 'WellKnownGroup'; 6 = 'DeletedAccount'; 7 = 'Invalid'; 8 = 'Unknown'; 9 = 'Computer' }
    $broadSids = @{ 'S-1-1-0' = 'Everyone'; 'S-1-5-11' = 'Authenticated Users'; 'S-1-5-7' = 'Anonymous'; 'S-1-5-32-545' = 'BUILTIN\Users'; 'S-1-5-4' = 'Interactive' }
    $broadRids = @{ '513' = 'Domain Users'; '515' = 'Domain Computers'; '514' = 'Domain Guests' }

    $err = 0
    $groupName = [ADAudit.Native]::LookupLocalName($ComputerName, 'S-1-5-32-544', [ref]$err)
    if (-not $groupName) { $groupName = 'Administrators' }

    $err = 0
    $members = [ADAudit.Native]::GetLocalGroupMembers($ComputerName, $groupName, [ref]$err)
    if ($err -ne 0) {
        $msg = switch ($err) {
            5 { 'Access denied (remote SAM enumeration restricted; run as local admin)' }
            53 { 'Network path not found' }
            1722 { 'RPC server unavailable' }
            2220 { "Group '$groupName' not found" }
            default { "NetLocalGroupGetMembers error $err" }
        }
        New-ADAuditResult -Scanner 'LocalAdmin' -Computer $ComputerName -Severity 'Info' -Finding $msg -Data ([ordered]@{
            Member = $null; MemberSid = $null; MemberType = $null; ErrorCode = $err
        })
        return
    }

    foreach ($m in $members) {
        $sid = [string]$m.Sid
        $type = $sidUsageNames[[int]$m.SidUsage]
        $rid = $(if ($sid -match '-(\d+)$') { $Matches[1] } else { $null })
        $sev = 'OK'; $finding = ''

        if ($broadSids.ContainsKey($sid)) {
            $sev = 'High'; $finding = "Broad principal '$($broadSids[$sid])' is a local admin"
        }
        elseif ($sid -match '^S-1-5-21-' -and $rid -and $broadRids.ContainsKey($rid) -and $m.SidUsage -eq 2) {
            $sev = 'High'; $finding = "Broad group '$($broadRids[$rid])' is a local admin"
        }
        elseif ($m.SidUsage -in 6, 7, 8 -or -not $m.Name) {
            $sev = 'Low'; $finding = 'Orphaned / unresolvable SID in local Administrators'
        }
        elseif ($m.SidUsage -eq 1 -and $rid -ne '500') {
            $sev = 'Low'; $finding = 'Individual user account is a local admin'
        }

        New-ADAuditResult -Scanner 'LocalAdmin' -Computer $ComputerName -Severity $sev -Finding $finding -Data ([ordered]@{
            Member = $m.Name; MemberSid = $sid; MemberType = $type; ErrorCode = 0
        })
    }
}
#endregion Scanners/LocalAdmin.ps1

#region Scanners/OSInventory.ps1
<#
    OSInventory (PingCastle equivalent: computerversion)
    AD-only. Reads operatingSystem / operatingSystemVersion / lastLogonTimestamp
    from computer objects and flags unsupported or soon-unsupported Windows builds.
    Nothing is sent to the computers themselves.

    End-of-support dates are a built-in table (as of late 2026). Verify against
    https://learn.microsoft.com/lifecycle before acting, and remember paid ESU
    can extend some products.
#>

function Get-ADAuditOSSupportInfo {
    param([string]$OperatingSystem, [string]$OSVersion)

    $os = "$OperatingSystem"
    $major = $null; $build = $null
    if ($OSVersion -match '^(\d+\.\d+)') { $major = $Matches[1] }
    if ($OSVersion -match '\((\d+)\)') { $build = [int]$Matches[1] }

    $product = $null; $eos = $null

    if (-not $os -or $os -notmatch 'Windows') {
        return [pscustomobject]@{ Product = $(if ($os) { $os } else { '(not recorded)' }); Build = $build; EndOfSupport = $null }
    }

    $isServer = $os -match 'Server'
    $isLtsc = $os -match 'LTS'
    $isEnt = $os -match 'Enterprise|Education'

    if ($isServer) {
        switch ($major) {
            '5.2' { $product = 'Windows Server 2003'; $eos = '2015-07-14' }
            '6.0' { $product = 'Windows Server 2008'; $eos = '2020-01-14' }
            '6.1' { $product = 'Windows Server 2008 R2'; $eos = '2020-01-14' }
            '6.2' { $product = 'Windows Server 2012'; $eos = '2023-10-10' }
            '6.3' { $product = 'Windows Server 2012 R2'; $eos = '2023-10-10' }
            '10.0' {
                switch ($build) {
                    14393 { $product = 'Windows Server 2016'; $eos = '2027-01-12' }
                    17763 { $product = 'Windows Server 2019'; $eos = '2029-01-09' }
                    20348 { $product = 'Windows Server 2022'; $eos = '2031-10-14' }
                    26100 { $product = 'Windows Server 2025'; $eos = '2034-10-10' }
                    default {
                        # Semi-Annual Channel server builds (1709-20H2) are all out of support
                        if ($build -and $build -lt 20348) { $product = "Windows Server SAC build $build"; $eos = '2022-08-09' }
                    }
                }
            }
        }
    }
    else {
        switch ($major) {
            '5.1' { $product = 'Windows XP'; $eos = '2014-04-08' }
            '6.0' { $product = 'Windows Vista'; $eos = '2017-04-11' }
            '6.1' { $product = 'Windows 7'; $eos = '2020-01-14' }
            '6.2' { $product = 'Windows 8'; $eos = '2016-01-12' }
            '6.3' { $product = 'Windows 8.1'; $eos = '2023-01-10' }
            '10.0' {
                if ($build -and $build -lt 22000) {
                    if ($isLtsc) {
                        switch ($build) {
                            10240 { $product = 'Windows 10 LTSB 2015'; $eos = '2025-10-14' }
                            14393 { $product = 'Windows 10 LTSB 2016'; $eos = '2026-10-13' }
                            17763 { $product = 'Windows 10 LTSC 2019'; $eos = '2029-01-09' }
                            19044 { $product = 'Windows 10 LTSC 2021'; $eos = '2027-01-12' }
                        }
                    }
                    if (-not $product) { $product = "Windows 10 (build $build)"; $eos = '2025-10-14' }
                }
                elseif ($build) {
                    if ($isLtsc -and $build -eq 26100) { $product = 'Windows 11 LTSC 2024'; $eos = '2029-10-09' }
                    else {
                        $tbl = @{
                            22000 = @('21H2', '2024-10-08', '2023-10-10')
                            22621 = @('22H2', '2025-10-14', '2024-10-08')
                            22631 = @('23H2', '2026-11-10', '2025-11-11')
                            26100 = @('24H2', '2027-10-12', '2026-10-13')
                            26200 = @('25H2', '2028-10-10', '2027-10-12')
                        }
                        if ($tbl.ContainsKey($build)) {
                            $row = $tbl[$build]
                            $product = "Windows 11 $($row[0]) " + $(if ($isEnt) { '(Ent/Edu)' } else { '(Home/Pro)' })
                            $eos = $(if ($isEnt) { $row[1] } else { $row[2] })
                        }
                        else { $product = "Windows 11 (build $build, not in table)" }
                    }
                }
            }
        }
    }

    if (-not $product) { $product = "$os $OSVersion".Trim() }
    $eosDate = $null
    if ($eos) { $eosDate = [DateTime]::ParseExact($eos, 'yyyy-MM-dd', [Globalization.CultureInfo]::InvariantCulture) }
    [pscustomobject]@{ Product = $product; Build = $build; EndOfSupport = $eosDate }
}

function Invoke-ADAuditOSInventory {
    [CmdletBinding()]
    param([Parameter(Mandatory)][object[]]$Computers, [int]$EndingSoonDays = 180)

    $today = (Get-Date).Date
    foreach ($c in $Computers) {
        $info = Get-ADAuditOSSupportInfo -OperatingSystem $c.OperatingSystem -OSVersion $c.OSVersion
        $status = 'Unknown'
        if ($info.EndOfSupport) {
            if ($info.EndOfSupport -lt $today) { $status = 'Unsupported' }
            elseif ($info.EndOfSupport -lt $today.AddDays($EndingSoonDays)) { $status = 'EndingSoon' }
            else { $status = 'Supported' }
        }

        $issues = @(); $sev = @()
        switch ($status) {
            'Unsupported' { $issues += "Out of support since $($info.EndOfSupport.ToString('yyyy-MM-dd'))"; $sev += 'High' }
            'EndingSoon'  { $issues += "Support ends $($info.EndOfSupport.ToString('yyyy-MM-dd'))"; $sev += 'Medium' }
            'Unknown'     { if (-not $c.OperatingSystem) { $issues += 'No OS recorded in AD' ; $sev += 'Info' } else { $issues += 'Support date unknown'; $sev += 'Low' } }
        }
        if ($c.IsStale) { $issues += 'Enabled account not seen recently (stale)'; $sev += 'Low' }

        New-ADAuditResult -Scanner 'OSInventory' -Computer $c.Name -Severity (Get-ADAuditMaxSeverity $sev) -Finding ($issues -join '; ') -Data ([ordered]@{
            DnsHostName        = $c.DnsHostName
            IsDomainController = $c.IsDomainController
            OperatingSystem    = $c.OperatingSystem
            OSVersion          = $c.OSVersion
            Product            = $info.Product
            EndOfSupport       = $(if ($info.EndOfSupport) { $info.EndOfSupport.ToString('yyyy-MM-dd') } else { $null })
            SupportStatus      = $status
            LastLogonUtc       = $c.LastLogonUtc
            IsStale            = $c.IsStale
            IssueSeverity = (@($sev) -join ';')
        })
    }
}
#endregion Scanners/OSInventory.ps1

#region Scanners/Permissions.ps1
<#
    Permissions (AD_Miner-style ACL checks, one hop, no BloodHound needed)
    Reads owner + DACL (nTSecurityDescriptor) of key objects over LDAP and reports
    principals that are NOT Tier 0 but hold rights that lead to domain compromise:

      DCSync          DS-Replication-Get-Changes(-All) on the domain root
      Tier-0 ACLs     GenericAll / WriteDacl / WriteOwner / write all properties /
                      all extended rights, plus object-specific rights (add member,
                      reset password, add key credential (shadow creds), write SPN,
                      RBCD, logon script, altSecurityIdentities) on: domain root,
                      AdminSDHolder, Domain Controllers OU, DC computers, krbtgt,
                      privileged groups and their members
      Owners          non-Tier-0 owner of any of those objects (owners can rewrite the ACL)
      GPOs            who can edit GPO objects (LDAP) and GPO folders in SYSVOL;
                      High when the GPO applies to DCs or the whole domain
      LAPS readers    who can read LAPS passwords on the domain root, OUs and CN=Computers
      gMSA readers    who can retrieve gMSA passwords (msDS-GroupMSAMembership)

    Only Allow ACEs are evaluated; Deny ACEs are ignored, so a finding may be
    blocked by a Deny in rare cases. Group membership of the principal is not
    expanded (one hop) - check who is in a flagged group.
#>

$script:ADAuditBroadSids = @{
    'S-1-1-0' = 'Everyone'; 'S-1-5-11' = 'Authenticated Users'; 'S-1-5-7' = 'Anonymous'
    'S-1-5-32-545' = 'Users'; 'S-1-5-2' = 'Network'; 'S-1-5-4' = 'Interactive'
}
$script:ADAuditBroadRids = @{ '513' = 'Domain Users'; '514' = 'Domain Guests'; '515' = 'Domain Computers' }
$script:ADAuditWellKnownNames = @{
    'S-1-5-18' = 'SYSTEM'; 'S-1-5-10' = 'SELF'; 'S-1-3-0' = 'CREATOR OWNER'; 'S-1-5-9' = 'Enterprise Domain Controllers'
    'S-1-5-32-544' = 'BUILTIN\Administrators'; 'S-1-5-32-548' = 'Account Operators'; 'S-1-5-32-549' = 'Server Operators'
    'S-1-5-32-550' = 'Print Operators'; 'S-1-5-32-551' = 'Backup Operators'; 'S-1-5-32-554' = 'Pre-Windows 2000 Compatible Access'
    'S-1-5-32-560' = 'Windows Authorization Access Group'; 'S-1-5-32-561' = 'Terminal Server License Servers'
}

function Test-ADAuditBroadSid {
    param([string]$Sid)
    if ($script:ADAuditBroadSids.ContainsKey($Sid)) { return $true }
    return ($Sid -match '^S-1-5-21-\d+-\d+-\d+-(\d+)$') -and $script:ADAuditBroadRids.ContainsKey($Matches[1])
}

function New-ADAuditSidResolver {
    <# Resolver context for Resolve-ADAuditSid (keeps a cache) #>
    param([string]$Server, [pscredential]$Credential, [string]$DomainSid, [string]$NetbiosName)
    [pscustomobject]@{ Server = $Server; Credential = $Credential; DomainSid = $DomainSid; Netbios = $NetbiosName; Cache = @{} }
}

function Resolve-ADAuditSid {
    <# 'S-1-...' -> 'DOMAIN\name' via well-known table, Windows lookup, then LDAP; falls back to the SID #>
    param([Parameter(Mandatory)]$Resolver, [string]$Sid)
    if (-not $Sid) { return $null }
    $cache = $Resolver.Cache
    if ($cache.ContainsKey($Sid)) { return $cache[$Sid] }
    $ridNames = @{ '512' = 'Domain Admins'; '513' = 'Domain Users'; '514' = 'Domain Guests'; '515' = 'Domain Computers'; '516' = 'Domain Controllers'; '517' = 'Cert Publishers'; '518' = 'Schema Admins'; '519' = 'Enterprise Admins'; '520' = 'Group Policy Creator Owners'; '521' = 'Read-only Domain Controllers'; '526' = 'Key Admins'; '527' = 'Enterprise Key Admins'; '553' = 'RAS and IAS Servers' }
    $name = $null
    if ($script:ADAuditWellKnownNames.ContainsKey($Sid)) { $name = $script:ADAuditWellKnownNames[$Sid] }
    elseif ($script:ADAuditBroadSids.ContainsKey($Sid)) { $name = $script:ADAuditBroadSids[$Sid] }
    if (-not $name) {
        try { $name = (New-Object System.Security.Principal.SecurityIdentifier($Sid)).Translate([System.Security.Principal.NTAccount]).Value } catch { }
    }
    if (-not $name) {
        try {
            $o = Invoke-ADAuditLdapQuery -Server $Resolver.Server -Credential $Resolver.Credential -Filter "(objectSid=$Sid)" -Properties 'sAMAccountName' | Select-Object -First 1
            if ($o.sAMAccountName) { $name = "$($Resolver.Netbios)\$($o.sAMAccountName)" }
        }
        catch { }
    }
    if (-not $name -and $Resolver.DomainSid -and $Sid -match "^$([regex]::Escape($Resolver.DomainSid))-(\d+)$" -and $ridNames.ContainsKey($Matches[1])) { $name = "$($Resolver.Netbios)\$($ridNames[$Matches[1]])" }
    if (-not $name) { $name = $Sid }
    $cache[$Sid] = $name
    return $name
}

function Get-ADAuditTier0Sids {
    <# SIDs whose rights on Tier-0 objects are expected (Tier 0 themselves, or built-in plumbing) #>
    param([string]$DomainSid, [string]$RootDomainSid, $Privileged)
    $t = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    foreach ($s in 'S-1-5-18', 'S-1-5-10', 'S-1-3-0', 'S-1-5-9', 'S-1-5-32-544', 'S-1-5-32-548', 'S-1-5-32-549', 'S-1-5-32-550', 'S-1-5-32-551') { [void]$t.Add($s) }
    foreach ($r in 512, 516, 518, 519, 520, 521, 526, 527, 498) {
        if ($DomainSid) { [void]$t.Add("$DomainSid-$r") }
        if ($RootDomainSid) { [void]$t.Add("$RootDomainSid-$r") }
    }
    if ($Privileged -and $Privileged.Sids) { foreach ($s in $Privileged.Sids) { [void]$t.Add($s) } }
    return , $t
}

function Get-ADAuditObjectKind {
    param([object[]]$ObjectClass)
    $c = @($ObjectClass | ForEach-Object { [string]$_ })
    if ($c -contains 'domainDNS') { return 'Domain' }
    if ($c -contains 'groupPolicyContainer') { return 'GPO' }
    if ($c -contains 'computer') { return 'Computer' }
    if ($c -contains 'group') { return 'Group' }
    if ($c -contains 'user') { return 'User' }
    if ($c -contains 'organizationalUnit') { return 'OU' }
    return 'Container'
}

function Get-ADAuditDangerousAce {
    <#
        Groups dangerous rights per principal for one object.
        Returns objects: Sid, Rights (string[]), Inherited (bool: all ACEs inherited)
    #>
    param([Parameter(Mandatory)]$Parsed, [Parameter(Mandatory)][string]$Kind, $TrustedSids)
    $by = [ordered]@{}
    foreach ($a in $Parsed.Aces) {
        if (-not $a.Sid -or ($TrustedSids -and $TrustedSids.Contains($a.Sid))) { continue }
        $rights = @(Get-ADAuditAceRight -Ace $a -Kind $Kind)
        if (-not $rights) { continue }
        if (-not $by.Contains($a.Sid)) { $by[$a.Sid] = @{ Rights = New-Object System.Collections.Generic.List[string]; Inherited = $true } }
        foreach ($r in $rights) { if (-not $by[$a.Sid].Rights.Contains($r)) { $by[$a.Sid].Rights.Add($r) } }
        if (-not $a.Inherited) { $by[$a.Sid].Inherited = $false }
    }
    foreach ($k in $by.Keys) { [pscustomobject]@{ Sid = $k; Rights = $by[$k].Rights.ToArray(); Inherited = $by[$k].Inherited } }
}

function Invoke-ADAuditPermissionScan {
    [CmdletBinding()]
    param(
        $Privileged,
        [string]$Server,
        [pscredential]$Credential,
        [switch]$SkipSysvol
    )

    $rootDse = Get-ADAuditRootDse -Server $Server -Credential $Credential
    $nc = $rootDse.DefaultNamingContext
    $config = $rootDse.ConfigurationNamingContext
    $domain = ConvertTo-ADAuditDnsName $nc

    $domObj = Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase $nc -Scope Base -Filter '(objectClass=*)' -Properties 'objectSid', 'objectClass', 'distinguishedName', 'gPLink' -SecurityDescriptor | Select-Object -First 1
    $domainSid = ConvertTo-ADAuditSidString $domObj.objectSid
    $rootSid = $domainSid
    if ($rootDse.RootDomainNamingContext -and $rootDse.RootDomainNamingContext -ne $nc) {
        try { $rootSid = ConvertTo-ADAuditSidString ((Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase $rootDse.RootDomainNamingContext -Scope Base -Filter '(objectClass=*)' -Properties 'objectSid' | Select-Object -First 1).objectSid) } catch { }
    }
    $netbios = $null
    try {
        $netbios = [string](Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase "CN=Partitions,$config" -Filter "(&(objectClass=crossRef)(nCName=$(ConvertTo-ADAuditLdapFilterValue $nc)))" -Properties 'nETBIOSName' | Select-Object -First 1).nETBIOSName
    }
    catch { }
    if (-not $netbios) { $netbios = ($domain -split '\.')[0].ToUpperInvariant() }

    $trusted = Get-ADAuditTier0Sids -DomainSid $domainSid -RootDomainSid $rootSid -Privileged $Privileged
    $resolve = New-ADAuditSidResolver -Server $Server -Credential $Credential -DomainSid $domainSid -NetbiosName $netbios

    function Out-Perm([string]$Target, [string]$Severity, [string]$Finding, [System.Collections.IDictionary]$Data) {
        New-ADAuditResult -Scanner 'Permissions' -Target $Target -Severity $Severity -Finding $Finding -Data $Data
    }
    function Get-Parsed($obj) {
        $b = $obj.nTSecurityDescriptor
        if (-not $b) { return $null }
        try { return ConvertFrom-ADAuditSecurityDescriptor -Bytes ([byte[]]$b) } catch { return $null }
    }
    function Out-Tier0Object($obj, [string]$Label, [string]$Kind) {
        $dn = [string]$obj.distinguishedName
        $parsed = Get-Parsed $obj
        if (-not $parsed) {
            Out-Perm $Label 'Info' 'Security descriptor not readable' ([ordered]@{ Check = 'ACL'; ObjectDN = $dn })
            return
        }
        if ($parsed.OwnerSid -and -not $trusted.Contains($parsed.OwnerSid)) {
            $who = Resolve-ADAuditSid -Resolver $resolve -Sid $parsed.OwnerSid
            $broad = Test-ADAuditBroadSid $parsed.OwnerSid
            Out-Perm $Label 'High' "Non-Tier-0 owner: $who$(if ($broad) { ' (broad group!)' }) - owners can rewrite the ACL" ([ordered]@{
                Check = 'Owner'; Principal = $who; PrincipalSid = $parsed.OwnerSid; Rights = 'Owner'; ObjectKind = $Kind; ObjectDN = $dn
            })
        }
        $k = $(if ($Kind -eq 'AdminSDHolder') { 'AdminSDHolder' } else { $Kind })
        foreach ($d in (Get-ADAuditDangerousAce -Parsed $parsed -Kind $k -TrustedSids $trusted)) {
            $rights = @($d.Rights | Where-Object { $_ -notin 'GetChanges', 'GetChangesAll', 'GetChangesInFilteredSet' })   # DCSync reported separately
            if (-not $rights) { continue }
            $who = Resolve-ADAuditSid -Resolver $resolve -Sid $d.Sid
            $broad = Test-ADAuditBroadSid $d.Sid
            Out-Perm $Label 'High' "Dangerous rights for non-Tier-0 $who$(if ($broad) { ' (broad group!)' }): $($rights -join ', ')" ([ordered]@{
                Check = 'ACL'; Principal = $who; PrincipalSid = $d.Sid; Rights = ($rights -join ', '); ObjectKind = $Kind; Inherited = $d.Inherited; ObjectDN = $dn
            })
        }
    }

    # ---------- 1. Domain root: DCSync + ACL ----------
    $parsedDomain = Get-Parsed $domObj
    if ($parsedDomain) {
        $repl = [ordered]@{}
        foreach ($a in $parsedDomain.Aces) {
            if (-not $a.Sid -or $trusted.Contains($a.Sid)) { continue }
            foreach ($r in (Get-ADAuditAceRight -Ace $a -Kind 'Domain')) {
                if ($r -in 'GetChanges', 'GetChangesAll', 'GenericAll', 'AllExtendedRights') {
                    if (-not $repl.Contains($a.Sid)) { $repl[$a.Sid] = New-Object 'System.Collections.Generic.HashSet[string]' }
                    [void]$repl[$a.Sid].Add($r)
                }
            }
        }
        foreach ($sid in $repl.Keys) {
            $r = $repl[$sid]
            $full = $r.Contains('GenericAll') -or $r.Contains('AllExtendedRights') -or ($r.Contains('GetChanges') -and $r.Contains('GetChangesAll'))
            $who = Resolve-ADAuditSid -Resolver $resolve -Sid $sid
            $isSync = $who -match '(?i)\\(MSOL_|AAD_|Sync_|ADSync)'
            if ($full) {
                $sev = $(if ($isSync) { 'Medium' } else { 'High' })
                $msg = "Can DCSync (dump all password hashes): $who"
                if ($isSync) { $msg += ' - looks like the Entra Connect sync account; expected, but it is Tier 0' }
            }
            elseif ($r.Contains('GetChangesAll')) { $sev = 'Medium'; $msg = "Has Replicating Directory Changes All (one right short of DCSync): $who" }
            else { continue }
            Out-Perm $domain $sev $msg ([ordered]@{ Check = 'DCSync'; Principal = $who; PrincipalSid = $sid; Rights = (@($r) -join ', '); ObjectKind = 'Domain'; ObjectDN = $nc })
        }
        Out-Tier0Object $domObj $domain 'Domain'
    }
    else { Out-Perm $domain 'Info' 'Domain root security descriptor not readable' ([ordered]@{ Check = 'ACL'; ObjectDN = $nc }) }

    # ---------- 2. Other Tier-0 objects ----------
    $props = 'distinguishedName', 'objectClass', 'sAMAccountName', 'name'
    $tier0 = New-Object System.Collections.ArrayList
    foreach ($spec in @(
            @{ Base = "CN=AdminSDHolder,CN=System,$nc"; Label = 'AdminSDHolder'; Kind = 'AdminSDHolder' },
            @{ Base = "OU=Domain Controllers,$nc"; Label = 'OU=Domain Controllers'; Kind = 'OU' })) {
        try {
            $o = Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase $spec.Base -Scope Base -Filter '(objectClass=*)' -Properties $props -SecurityDescriptor | Select-Object -First 1
            if ($o) { [void]$tier0.Add(@{ Obj = $o; Label = $spec.Label; Kind = $spec.Kind }) }
        }
        catch { Out-Perm $spec.Label 'Info' "Not readable: $($_.Exception.Message)" ([ordered]@{ Check = 'ACL'; ObjectDN = $spec.Base }) }
    }
    $dcFilter = '(&(objectCategory=computer)(|(userAccountControl:1.2.840.113556.1.4.803:=8192)(userAccountControl:1.2.840.113556.1.4.803:=67108864)))'
    foreach ($o in (Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase $nc -Filter $dcFilter -Properties $props -SecurityDescriptor)) {
        [void]$tier0.Add(@{ Obj = $o; Label = [string]$o.sAMAccountName; Kind = 'Computer' })
    }
    if ($domainSid) {
        foreach ($o in (Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase $nc -Filter "(objectSid=$domainSid-502)" -Properties $props -SecurityDescriptor)) {
            [void]$tier0.Add(@{ Obj = $o; Label = 'krbtgt'; Kind = 'User' })
        }
    }
    $seenDn = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    foreach ($t in $tier0) { [void]$seenDn.Add([string]$t.Obj.distinguishedName) }
    if ($Privileged) {
        $dns = @($Privileged.Groups | ForEach-Object { $_.DistinguishedName }) + @($Privileged.Members | ForEach-Object { $_.MemberDN })
        foreach ($dn in ($dns | Select-Object -Unique)) {
            if (-not $dn -or $seenDn.Contains($dn)) { continue }
            if ($dn -match '^CN=S-1-') { continue }   # foreign security principals
            try {
                $o = Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase $dn -Scope Base -Filter '(objectClass=*)' -Properties $props -SecurityDescriptor | Select-Object -First 1
                if ($o) {
                    [void]$seenDn.Add($dn)
                    [void]$tier0.Add(@{ Obj = $o; Label = $(if ($o.sAMAccountName) { [string]$o.sAMAccountName } else { [string]$o.name }); Kind = (Get-ADAuditObjectKind $o.objectClass) })
                }
            }
            catch { }
        }
    }
    foreach ($t in $tier0) { Out-Tier0Object $t.Obj $t.Label $t.Kind }

    # ---------- 3. GPOs (AD object + SYSVOL folder) ----------
    $ouObj = Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase "OU=Domain Controllers,$nc" -Scope Base -Filter '(objectClass=*)' -Properties 'gPLink' | Select-Object -First 1
    $tier0Gpo = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    foreach ($l in @(ConvertFrom-ADAuditGpLink ([string]$domObj.gPLink)) + @(ConvertFrom-ADAuditGpLink ([string]$ouObj.gPLink))) { if (-not $l.Disabled) { [void]$tier0Gpo.Add($l.GpoDN) } }

    foreach ($g in (Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase "CN=Policies,CN=System,$nc" -Filter '(objectClass=groupPolicyContainer)' -Properties 'distinguishedName', 'displayName', 'gPCFileSysPath' -SecurityDescriptor)) {
        $dn = [string]$g.distinguishedName
        $name = [string]$g.displayName
        $isT0 = $tier0Gpo.Contains($dn)
        $scope = $(if ($isT0) { 'applies to DCs or the whole domain' } else { 'other GPO' })
        $sev = $(if ($isT0) { 'High' } else { 'Medium' })
        $parsed = Get-Parsed $g
        if ($parsed) {
            if ($parsed.OwnerSid -and -not $trusted.Contains($parsed.OwnerSid)) {
                $who = Resolve-ADAuditSid -Resolver $resolve -Sid $parsed.OwnerSid
                Out-Perm $name $sev "GPO owned by non-Tier-0 $who ($scope)" ([ordered]@{ Check = 'GPOOwner'; Principal = $who; PrincipalSid = $parsed.OwnerSid; Rights = 'Owner'; ObjectKind = 'GPO'; Tier0Gpo = $isT0; ObjectDN = $dn })
            }
            foreach ($d in (Get-ADAuditDangerousAce -Parsed $parsed -Kind 'GPO' -TrustedSids $trusted)) {
                $who = Resolve-ADAuditSid -Resolver $resolve -Sid $d.Sid
                $broad = Test-ADAuditBroadSid $d.Sid
                Out-Perm $name $(if ($broad) { 'High' } else { $sev }) "Can edit GPO: $who$(if ($broad) { ' (broad group!)' }) - $($d.Rights -join ', ') ($scope)" ([ordered]@{
                    Check = 'GPOEdit'; Principal = $who; PrincipalSid = $d.Sid; Rights = ($d.Rights -join ', '); ObjectKind = 'GPO'; Tier0Gpo = $isT0; ObjectDN = $dn
                })
            }
        }

        $path = [string]$g.gPCFileSysPath
        if (-not $SkipSysvol -and $path) {
            try {
                $acl = Get-Acl -LiteralPath $path -ErrorAction Stop
                $bad = [ordered]@{}
                foreach ($r in $acl.GetAccessRules($true, $true, [System.Security.Principal.SecurityIdentifier])) {
                    if ($r.AccessControlType -ne 'Allow') { continue }
                    $sid = $r.IdentityReference.Value
                    if ($trusted.Contains($sid)) { continue }
                    $m = [int64]$r.FileSystemRights
                    # WriteData/AppendData/Delete/ChangePermissions/TakeOwnership or generic write/all
                    if (($m -band (0x2 -bor 0x4 -bor 0x10000 -bor 0x40000 -bor 0x80000 -bor 0x10000000 -bor 0x40000000)) -ne 0) { $bad[$sid] = "$($r.FileSystemRights)" }
                }
                foreach ($sid in $bad.Keys) {
                    $who = Resolve-ADAuditSid -Resolver $resolve -Sid $sid
                    $broad = Test-ADAuditBroadSid $sid
                    Out-Perm $name $(if ($broad) { 'High' } else { $sev }) "Can modify GPO files in SYSVOL: $who$(if ($broad) { ' (broad group!)' }) - $($bad[$sid]) ($scope)" ([ordered]@{
                        Check = 'SysvolEdit'; Principal = $who; PrincipalSid = $sid; Rights = $bad[$sid]; ObjectKind = 'GPO'; Tier0Gpo = $isT0; ObjectDN = $path
                    })
                }
            }
            catch { Out-Perm $name 'Info' "SYSVOL folder ACL not readable: $($_.Exception.Message)" ([ordered]@{ Check = 'SysvolEdit'; ObjectDN = $path }) }
        }
    }

    # ---------- 4. Who can link GPOs to the domain root / DC OU ----------
    # (covered by Tier-0 ACL rows above: WriteGPLink is reported for Domain and OU kinds)

    # ---------- 5. LAPS password readers ----------
    $lapsGuids = @{}
    try {
        foreach ($a in (Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase "CN=Schema,$config" -Filter '(|(lDAPDisplayName=ms-Mcs-AdmPwd)(lDAPDisplayName=msLAPS-Password)(lDAPDisplayName=msLAPS-EncryptedPassword))' -Properties 'lDAPDisplayName', 'schemaIDGUID')) {
            if ($a.schemaIDGUID) { $lapsGuids[([Guid]::new([byte[]]$a.schemaIDGUID)).ToString()] = [string]$a.lDAPDisplayName }
        }
    }
    catch { }
    if ($lapsGuids.Count -gt 0) {
        $containers = @($domObj)
        $containers += @(Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase $nc -Filter '(objectCategory=organizationalUnit)' -Properties 'distinguishedName', 'objectClass' -SecurityDescriptor)
        try { $containers += @(Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase "CN=Computers,$nc" -Scope Base -Filter '(objectClass=*)' -Properties 'distinguishedName', 'objectClass' -SecurityDescriptor) } catch { }
        $computerGuid = $script:ADAuditClassGuid.computer
        $readers = [ordered]@{}
        foreach ($c in $containers) {
            $parsed = Get-Parsed $c
            if (-not $parsed) { continue }
            foreach ($a in $parsed.Aces) {
                if (-not $a.Sid -or $trusted.Contains($a.Sid) -or -not (Test-ADAuditAceInheritsTo -Ace $a -ClassGuid $computerGuid)) { continue }
                if ($a.Inherited) { continue }   # report where the delegation is set, not every OU it flows into
                $m = [int64]$a.Mask
                $ga = ($m -band 0x10000000) -or (($m -band 0xF01FF) -eq 0xF01FF)
                $cr = ($m -band 0x100) -and ((-not $a.ObjectType) -or $lapsGuids.ContainsKey($a.ObjectType))
                if (-not ($ga -or $cr)) { continue }
                $attr = $(if ($a.ObjectType -and $lapsGuids.ContainsKey($a.ObjectType)) { $lapsGuids[$a.ObjectType] } elseif ($ga) { 'GenericAll' } else { 'AllExtendedRights' })
                $key = "$($a.Sid)|$($c.distinguishedName)"
                if (-not $readers.Contains($key)) { $readers[$key] = @{ Sid = $a.Sid; DN = [string]$c.distinguishedName; Attrs = New-Object 'System.Collections.Generic.HashSet[string]' } }
                [void]$readers[$key].Attrs.Add($attr)
            }
        }
        foreach ($r in $readers.Values) {
            $who = Resolve-ADAuditSid -Resolver $resolve -Sid $r.Sid
            $broad = Test-ADAuditBroadSid $r.Sid
            Out-Perm $r.DN $(if ($broad) { 'High' } else { 'Low' }) "Can read LAPS passwords of computers below: $who$(if ($broad) { ' (broad group!)' })" ([ordered]@{
                Check = 'LapsRead'; Principal = $who; PrincipalSid = $r.Sid; Rights = (@($r.Attrs) -join ', '); ObjectKind = 'OU'; ObjectDN = $r.DN
            })
        }
    }

    # ---------- 6. gMSA password readers ----------
    try {
        foreach ($g in (Invoke-ADAuditLdapQuery -Server $Server -Credential $Credential -SearchBase $nc -Filter '(objectClass=msDS-GroupManagedServiceAccount)' -Properties 'sAMAccountName', 'distinguishedName', 'msDS-GroupMSAMembership')) {
            $b = $g.'msDS-GroupMSAMembership'
            if (-not $b) { continue }
            $isPrivGmsa = $Privileged -and $Privileged.MapByMember.ContainsKey([string]$g.distinguishedName)
            $parsed = $null
            try { $parsed = ConvertFrom-ADAuditSecurityDescriptor -Bytes ([byte[]]$b) } catch { continue }
            foreach ($a in $parsed.Aces) {
                if (-not $a.Allow -or -not $a.Sid) { continue }
                $who = Resolve-ADAuditSid -Resolver $resolve -Sid $a.Sid
                $broad = Test-ADAuditBroadSid $a.Sid
                $isTrusted = $trusted.Contains($a.Sid)
                if ($isTrusted) { continue }
                $sev = $(if ($broad) { 'High' } elseif ($isPrivGmsa -and -not $isTrusted) { 'High' } else { 'Info' })
                $msg = $(if ($isPrivGmsa -and -not $isTrusted) { "Non-Tier-0 $who can read the password of privileged gMSA" } elseif ($broad) { "Broad group $who can read gMSA password" } else { "Can read gMSA password: $who" })
                Out-Perm ([string]$g.sAMAccountName) $sev $msg ([ordered]@{ Check = 'GmsaRead'; Principal = $who; PrincipalSid = $a.Sid; ObjectKind = 'gMSA'; PrivilegedGmsa = [bool]$isPrivGmsa; ObjectDN = [string]$g.distinguishedName })
            }
        }
    }
    catch { Out-Perm '(gMSA)' 'Info' "gMSA query failed: $($_.Exception.Message)" ([ordered]@{ Check = 'GmsaRead' }) }
}
#endregion Scanners/Permissions.ps1

#region Scanners/Share.ps1
<#
    Share (PingCastle equivalent: share)
    Enumerates shares with NetShareEnum (level 1, read-only) and, for disk shares,
    checks whether the scanning account can LIST the share root. It reads at most
    one directory entry and never opens, writes or changes files or ACLs.

    Tip: run this scanner as a plain domain user. Anything it can list is then
    readable by every domain user, which is what you want to find.
#>

function Invoke-ADAuditShareScan {
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$ComputerName, [bool]$IsDomainController)

    $expected = @('SYSVOL', 'NETLOGON', 'print$')
    $err = 0
    $shares = [ADAudit.Native]::GetShares($ComputerName, [ref]$err)
    if ($err -ne 0) {
        $msg = switch ($err) { 5 { 'Access denied enumerating shares' } 53 { 'Network path not found' } default { "NetShareEnum error $err" } }
        New-ADAuditResult -Scanner 'Share' -Computer $ComputerName -Severity 'Info' -Finding $msg -Data ([ordered]@{
            Share = $null; ShareType = $null; IsSpecial = $null; Remark = $null; ListableByScanner = $null
        })
        return
    }

    $specialFlag = [uint32]2147483648   # STYPE_SPECIAL (0x80000000)
    foreach ($s in $shares) {
        $base = [uint32]($s.Type -band [uint32]0x0FFFFFFF)
        $isSpecial = ($s.Type -band $specialFlag) -ne 0
        $typeName = switch ($base) { 0 { 'Disk' } 1 { 'Print' } 2 { 'Device' } 3 { 'IPC' } default { "Type$base" } }
        if ($typeName -ne 'Disk') { continue }

        $unc = "\\$ComputerName\$($s.Name)"
        $listable = $false
        try {
            $enum = [System.IO.Directory]::EnumerateFileSystemEntries($unc).GetEnumerator()
            try { [void]$enum.MoveNext() } finally { $enum.Dispose() }
            $listable = $true
        }
        catch { $listable = $false }

        $sev = 'OK'; $finding = ''
        if ($listable) {
            if ($isSpecial) { $sev = 'Info'; $finding = 'Admin share listable (scanning account has admin rights here)' }
            elseif ($expected -contains $s.Name) { $sev = 'OK' }
            else { $sev = 'Medium'; $finding = 'Share root listable by scanning account - review share/NTFS permissions' }
        }

        New-ADAuditResult -Scanner 'Share' -Computer $ComputerName -Severity $sev -Finding $finding -Data ([ordered]@{
            Share = $s.Name; ShareType = $typeName; IsSpecial = $isSpecial; Remark = $s.Remark; ListableByScanner = $listable
        })
    }
}
#endregion Scanners/Share.ps1

#region Scanners/Smb.ps1
<#
    Smb (PingCastle equivalents: smb, smb3querynetwork-lite)
    Sends only SMB NEGOTIATE packets - the same first packet every SMB client sends.
    No session setup, no authentication, no file access.

      1. SMB2/3 NEGOTIATE (dialects 2.0.2 - 3.0.2) -> highest dialect + whether signing is REQUIRED
      2. SMB1 NEGOTIATE ("NT LM 0.12" only)        -> whether the server still answers SMB1

    Heads-up: if "Audit SMB1 access" is enabled on targets, the SMB1 probe logs
    event 3000 (Microsoft-Windows-SMBServer/Audit). Use -SkipSmb1 to avoid it.
#>

function Read-ADAuditStreamBytes {
    param([Parameter(Mandatory)]$Stream, [Parameter(Mandatory)][int]$Count)
    $buf = New-Object byte[] $Count
    $off = 0
    while ($off -lt $Count) {
        $n = $Stream.Read($buf, $off, $Count - $off)
        if ($n -le 0) { return $null }
        $off += $n
    }
    return , $buf
}

function Invoke-ADAuditSmbExchange {
    <#
        Sends one SMB message (direct TCP framing on 445) and returns the response bytes,
        or $null if the server closed/reset the connection. Throws on timeouts.
    #>
    param([Parameter(Mandatory)][string]$ComputerName, [Parameter(Mandatory)][byte[]]$Packet, [int]$TimeoutMs = 3000)

    $client = New-Object System.Net.Sockets.TcpClient
    try {
        $ar = $client.BeginConnect($ComputerName, 445, $null, $null)
        if (-not $ar.AsyncWaitHandle.WaitOne($TimeoutMs)) { throw "Connection to ${ComputerName}:445 timed out" }
        $client.EndConnect($ar)
        $stream = $client.GetStream()
        $stream.ReadTimeout = $TimeoutMs
        $stream.WriteTimeout = $TimeoutMs

        $frame = New-Object byte[] ($Packet.Length + 4)
        $frame[1] = [byte](($Packet.Length -shr 16) -band 0xFF)
        $frame[2] = [byte](($Packet.Length -shr 8) -band 0xFF)
        $frame[3] = [byte]($Packet.Length -band 0xFF)
        [Array]::Copy($Packet, 0, $frame, 4, $Packet.Length)

        try {
            $stream.Write($frame, 0, $frame.Length)
            $hdr = Read-ADAuditStreamBytes -Stream $stream -Count 4
            if (-not $hdr) { return $null }
            $len = ([int]$hdr[1] -shl 16) -bor ([int]$hdr[2] -shl 8) -bor [int]$hdr[3]
            if ($len -le 0 -or $len -gt 1048576) { return $null }
            $body = Read-ADAuditStreamBytes -Stream $stream -Count $len
            return , $body
        }
        catch [System.IO.IOException] {
            $se = $_.Exception.InnerException -as [System.Net.Sockets.SocketException]
            if ($se -and $se.SocketErrorCode -eq [System.Net.Sockets.SocketError]::TimedOut) { throw "SMB read from $ComputerName timed out" }
            return $null   # connection reset/closed by server
        }
    }
    finally { $client.Close() }
}

function New-ADAuditSmb2NegotiatePacket {
    $dialects = [uint16[]](0x0202, 0x0210, 0x0300, 0x0302)
    $ms = New-Object System.IO.MemoryStream
    $bw = New-Object System.IO.BinaryWriter($ms)
    # SMB2 header (64 bytes)
    $bw.Write([byte[]](0xFE, 0x53, 0x4D, 0x42))
    $bw.Write([uint16]64)       # StructureSize
    $bw.Write([uint16]0)        # CreditCharge
    $bw.Write([uint32]0)        # Status
    $bw.Write([uint16]0)        # Command = NEGOTIATE
    $bw.Write([uint16]1)        # CreditRequest
    $bw.Write([uint32]0)        # Flags
    $bw.Write([uint32]0)        # NextCommand
    $bw.Write([uint64]0)        # MessageId
    $bw.Write([uint32]0)        # Reserved
    $bw.Write([uint32]0)        # TreeId
    $bw.Write([uint64]0)        # SessionId
    $bw.Write((New-Object byte[] 16))  # Signature
    # NEGOTIATE request
    $bw.Write([uint16]36)       # StructureSize
    $bw.Write([uint16]$dialects.Count)
    $bw.Write([uint16]1)        # SecurityMode: signing enabled
    $bw.Write([uint16]0)        # Reserved
    $bw.Write([uint32]0)        # Capabilities
    $bw.Write([guid]::NewGuid().ToByteArray())
    $bw.Write([uint64]0)        # ClientStartTime
    foreach ($d in $dialects) { $bw.Write([uint16]$d) }
    $bw.Flush()
    return , $ms.ToArray()
}

function New-ADAuditSmb1NegotiatePacket {
    $ms = New-Object System.IO.MemoryStream
    $bw = New-Object System.IO.BinaryWriter($ms)
    # SMB1 header (32 bytes)
    $bw.Write([byte[]](0xFF, 0x53, 0x4D, 0x42))
    $bw.Write([byte]0x72)       # SMB_COM_NEGOTIATE
    $bw.Write([uint32]0)        # Status
    $bw.Write([byte]0x18)       # Flags
    $bw.Write([uint16]0xC853)   # Flags2
    $bw.Write([uint16]0)        # PIDHigh
    $bw.Write((New-Object byte[] 8))  # SecurityFeatures
    $bw.Write([uint16]0)        # Reserved
    $bw.Write([uint16]0)        # TID
    $bw.Write([uint16]0xFEFF)   # PIDLow
    $bw.Write([uint16]0)        # UID
    $bw.Write([uint16]0)        # MID
    # Body: WordCount=0, ByteCount, dialect "NT LM 0.12"
    [byte[]]$dialect = @([byte]0x02) + [Text.Encoding]::ASCII.GetBytes('NT LM 0.12') + @([byte]0x00)
    $bw.Write([byte]0)
    $bw.Write([uint16]$dialect.Length)
    $bw.Write($dialect)
    $bw.Flush()
    return , $ms.ToArray()
}

function Invoke-ADAuditSmbScan {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$ComputerName,
        [bool]$IsDomainController,
        [int]$TimeoutMs = 3000,
        [switch]$SkipSmb1
    )

    $dialect = $null; $signingRequired = $null; $signingEnabled = $null; $note = $null
    $resp = Invoke-ADAuditSmbExchange -ComputerName $ComputerName -Packet (New-ADAuditSmb2NegotiatePacket) -TimeoutMs $TimeoutMs
    if ($resp) {
        [byte[]]$r = $resp
        if ($r.Length -ge 70 -and $r[0] -eq 0xFE -and $r[1] -eq 0x53 -and $r[2] -eq 0x4D -and $r[3] -eq 0x42) {
            $status = [BitConverter]::ToUInt32($r, 8)
            if ($status -eq 0) {
                $secMode = [BitConverter]::ToUInt16($r, 66)
                $dialect = '{0}.{1}.{2}' -f (([BitConverter]::ToUInt16($r, 68)) -shr 8), ((([BitConverter]::ToUInt16($r, 68)) -shr 4) -band 0xF), (([BitConverter]::ToUInt16($r, 68)) -band 0xF)
                $signingEnabled = ($secMode -band 0x1) -ne 0
                $signingRequired = ($secMode -band 0x2) -ne 0
            }
            else { $note = ('SMB2 negotiate status 0x{0:X8}' -f $status) }
        }
        else { $note = 'Unexpected SMB2 negotiate response' }
    }
    else { $note = 'SMB2 negotiate rejected' }

    $smb1 = 'NotTested'
    if (-not $SkipSmb1) {
        $r1 = Invoke-ADAuditSmbExchange -ComputerName $ComputerName -Packet (New-ADAuditSmb1NegotiatePacket) -TimeoutMs $TimeoutMs
        if ($r1 -and $r1.Count -ge 4 -and $r1[0] -eq 0xFF -and $r1[1] -eq 0x53 -and $r1[2] -eq 0x4D -and $r1[3] -eq 0x42) { $smb1 = 'Enabled' }
        else { $smb1 = 'Disabled' }
    }

    $issues = @(); $sev = @()
    if ($smb1 -eq 'Enabled') {
        $issues += 'SMBv1 enabled'
        $sev += $(if ($IsDomainController) { 'High' } else { 'Medium' })
    }
    if ($signingRequired -eq $false) {
        $issues += 'SMB signing not required (NTLM relay target)'
        $sev += $(if ($IsDomainController) { 'High' } else { 'Low' })
    }
    if ($note -and $null -eq $signingRequired) { $issues += $note; $sev += 'Info' }

    New-ADAuditResult -Scanner 'Smb' -Computer $ComputerName -Severity (Get-ADAuditMaxSeverity $sev) -Finding ($issues -join '; ') -Data ([ordered]@{
        IsDomainController = $IsDomainController
        Smb2Dialect        = $dialect
        SigningEnabled     = $signingEnabled
        SigningRequired    = $signingRequired
        Smb1               = $smb1
        IssueSeverity = (@($sev) -join ';')
    })
}
#endregion Scanners/Smb.ps1

#region Scanners/Spooler.ps1
<#
    Spooler (PingCastle equivalent: spooler)
    Checks whether the Print Spooler named pipe (\\host\pipe\spoolss) is reachable.
    This only asks for the pipe's attributes over SMB; it makes no RPC calls to the
    spooler and does not trigger any authentication coercion.

    Spooler on a DC enables "printer bug" coercion and PrintNightmare-class issues.
#>

function Invoke-ADAuditSpoolerScan {
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$ComputerName, [bool]$IsDomainController)

    $exposed = $false
    try { $exposed = [bool](Test-Path -LiteralPath "\\$ComputerName\pipe\spoolss" -ErrorAction Stop) }
    catch { $exposed = $false }

    if ($exposed -and $IsDomainController) { $sev = 'High'; $finding = 'Print Spooler reachable on a domain controller (coercion / PrintNightmare risk)' }
    elseif ($exposed) { $sev = 'Info'; $finding = 'Print Spooler reachable' }
    else { $sev = 'OK'; $finding = '' }

    New-ADAuditResult -Scanner 'Spooler' -Computer $ComputerName -Severity $sev -Finding $finding -Data ([ordered]@{
        IsDomainController = $IsDomainController
        SpoolerPipeOpen    = $exposed
    })
}
#endregion Scanners/Spooler.ps1

#region runner
function Invoke-DtechtAD {
<#
.SYNOPSIS
    Read-only Active Directory host and configuration scanners (PingCastle-style).

.DESCRIPTION
    Runs any combination of these scanners and writes one CSV per scanner,
    AllFindings.csv (one row per issue, with category and remediation),
    results.json and Summary.html (risk scores, changes, findings) to the output folder.
    With -Baseline it also writes Changes.csv: what changed since a previous run.

      AD-only (LDAP reads, nothing sent to hosts):
        DomainPolicy   - password/lockout policy, MachineAccountQuota, krbtgt age, Guest, Pre-Win2000 access
        Accounts       - privileged & service accounts, password never expires, never logged on,
                         stale, Kerberoast / AS-REP, delegation, too many groups, SID history, adminCount
        Groups         - Domain Admins & other privileged groups (direct + nested members),
                         deep / circular group nesting
        OSInventory    - unsupported / soon-unsupported Windows versions, stale accounts
        LapsBitLocker  - LAPS (legacy + Windows LAPS) coverage, BitLocker key escrow
        DomainControllers - DC inventory: site, IPs, OS, RODC/GC, FSMO roles, redundancy
        AuditPolicy    - audit policy applied to DCs by GPO (read from SYSVOL), missing subcategories
        Permissions    - DCSync rights, dangerous ACEs / owners on Tier-0 objects, GPO edit rights
                         (AD + SYSVOL), LAPS and gMSA password readers

      Per-DC (read-only Security log query over RPC):
        Events         - account / group / SID history / DSRM / delegation / ACL changes in the
                         last -EventDays days, and how far back the Security log actually goes

      Per-host (read-only network queries over TCP 445):
        Spooler        - Print Spooler pipe reachable (critical on DCs)
        Smb            - SMBv1 enabled, SMB signing required, highest SMB2/3 dialect
        LocalAdmin     - members of BUILTIN\Administrators
        Share          - shares, and which share roots the scanning account can list

    READ-ONLY: nothing is written to AD, DCs or scanned hosts. The only files written
    are the reports in -OutputPath on this machine (local paths only). tests/Test-ReadOnly.ps1
    checks the code for write-capable calls. LDAP auth can use -Credential;
    per-host scanners always use the current Windows logon (use runas /netonly
    to scan as a different domain account).

.EXAMPLE
    Invoke-DtechtAD
    All scanners, all enabled computers seen in the last 90 days, current domain.

.EXAMPLE
    Invoke-DtechtAD -Preset ADOnly -OpenReport
    AD-only scan (LDAP + SYSVOL, no traffic to member hosts); opens the report when done.

.EXAMPLE
    Invoke-DtechtAD -Scanners Smb,Spooler -DomainControllersOnly
    Check only DCs for SMB and Spooler issues.

.EXAMPLE
    Invoke-DtechtAD -Baseline .\ADAudit-20261101-090000
    Full run, plus Changes.csv / a "Changes since baseline" section comparing against an earlier run.

.EXAMPLE
    Invoke-DtechtAD -Scanners Events,AuditPolicy -EventDays 30
    Review the last 30 days of account and group changes on every DC.

.EXAMPLE
    Invoke-DtechtAD -ComputerName srv01.corp.local,srv02.corp.local -Scanners Share,LocalAdmin
#>
[CmdletBinding()]
param(
    [ValidateSet('DomainPolicy', 'Accounts', 'Groups', 'OSInventory', 'LapsBitLocker', 'DomainControllers', 'AuditPolicy', 'Permissions', 'Events', 'Spooler', 'Smb', 'LocalAdmin', 'Share')]
    [string[]]$Scanners = @('DomainPolicy', 'Accounts', 'Groups', 'OSInventory', 'LapsBitLocker', 'DomainControllers', 'AuditPolicy', 'Permissions', 'Events', 'Spooler', 'Smb', 'LocalAdmin', 'Share'),

    [string]$Server,
    [string]$SearchBase,
    [pscredential]$Credential,

    # Limit per-host scanners to these hosts (names or FQDNs)
    [string[]]$ComputerName,
    [switch]$DomainControllersOnly,

    [int]$ActiveDays = 90,
    [int]$PasswordAgeDays = 365,
    [int]$MaxGroupMemberships = 20,
    [int]$MaxNestingDepth = 3,
    [int]$MaxDomainAdmins = 5,
    # Permissions: don't read GPO folder ACLs in SYSVOL
    [switch]$SkipSysvol,
    [string]$ServiceAccountPattern = '^(svc|srv|sa|sql|app|service)[-_.]|[-_.](svc|service|sa)$|^svc',
    [ValidateRange(1, 128)][int]$Throttle = 16,
    [ValidateRange(5, 3600)][int]$TimeoutSeconds = 120,
    [ValidateRange(250, 60000)][int]$NetworkTimeoutMs = 3000,
    [switch]$SkipSmb1,

    # Events scanner
    [ValidateRange(1, 365)][int]$EventDays = 7,
    [ValidateRange(100, 1000000)][int]$EventMaxPerDC = 5000,

    # Previous run folder (or its results.json) to compare against
    [string]$Baseline,

    [string]$OutputPath = (Join-Path -Path (Get-Location) -ChildPath ("ADAudit-" + (Get-Date -Format 'yyyyMMdd-HHmmss'))),

    # Full (default) | ADOnly: LDAP + SYSVOL only, no traffic to member hosts |
    # DCsOnly: AD checks plus Events/Spooler/SMB on DCs only | HostsOnly: per-host scanners
    [ValidateSet('Full', 'ADOnly', 'DCsOnly', 'HostsOnly')][string]$Preset,

    # Open Summary.html when the run finishes
    [switch]$OpenReport
)

$ErrorActionPreference = 'Stop'


# Presets: a quick way to pick scanners. An explicit -Scanners wins.
if ($Preset -and -not $PSBoundParameters.ContainsKey('Scanners')) {
    $adOnly = @('DomainPolicy', 'Accounts', 'Groups', 'OSInventory', 'LapsBitLocker', 'DomainControllers', 'AuditPolicy', 'Permissions')
    switch ($Preset) {
        'Full' { }
        'ADOnly' { $Scanners = $adOnly }
        'DCsOnly' { $Scanners = $adOnly + 'Events', 'Spooler', 'Smb'; $DomainControllersOnly = [switch]$true }
        'HostsOnly' { $Scanners = @('Spooler', 'Smb', 'LocalAdmin', 'Share') }
    }
}
# netapi32 helpers (NetLocalGroupGetMembers / NetShareEnum, read-only) are only compiled when needed
if ($Scanners -contains 'LocalAdmin' -or $Scanners -contains 'Share') { Import-ADAuditNative }

$adScanners = @($Scanners | Where-Object { $_ -in 'DomainPolicy', 'Accounts', 'Groups', 'OSInventory', 'LapsBitLocker', 'DomainControllers', 'AuditPolicy', 'Permissions' })
$hostScanners = @($Scanners | Where-Object { $_ -in 'Spooler', 'Smb', 'LocalAdmin', 'Share' })
# Reports stay on this machine: refuse network paths so nothing is written to a DC, share or scanned host
if ($OutputPath -match '^(\\\\|//)' -or ($OutputPath -match '^[A-Za-z]:' -and ([System.IO.DriveInfo]::new($OutputPath.Substring(0, 1))).DriveType -eq 'Network')) {
    throw "-OutputPath must be a local folder (got '$OutputPath'). Copy the reports elsewhere afterwards."
}

$results = New-Object System.Collections.ArrayList
$started = Get-Date

# Load the baseline first so a bad path fails before a long scan
$baselineRun = $null
if ($Baseline) {
    $baselineRun = Read-ADAuditRun -Path $Baseline
    Write-Host ("[+] Baseline: {0} ({1} results)" -f $baselineRun.Meta.Generated, @($baselineRun.Results).Count)
}

# ---------- AD inventory ----------
$allComputers = @()
try {
    Write-Host "[*] Reading computer accounts from AD..."
    $allComputers = @(Get-ADAuditComputer -Server $Server -SearchBase $SearchBase -Credential $Credential -ActiveDays $ActiveDays -IncludeStale)
    Write-Host ("[+] {0} enabled computer accounts ({1} active in last {2} days, {3} DCs)" -f $allComputers.Count, @($allComputers | Where-Object { -not $_.IsStale }).Count, $ActiveDays, @($allComputers | Where-Object { $_.IsDomainController }).Count)
}
catch {
    if ($adScanners.Count -gt 0 -or -not $ComputerName) { throw "AD query failed: $($_.Exception.Message)" }
    Write-Warning "AD query failed ($($_.Exception.Message)); continuing with -ComputerName only and treating targets as non-DCs."
}

$adScope = $allComputers
if ($DomainControllersOnly) { $adScope = @($allComputers | Where-Object { $_.IsDomainController }) }

$groupInventory = $null; $privileged = $null
if (@($Scanners | Where-Object { $_ -in 'Accounts', 'Groups', 'Events', 'Permissions', 'DomainPolicy' }).Count -gt 0) {
    Write-Host "[*] Resolving privileged group membership (direct + nested)..."
    $groupInventory = @(Get-ADAuditGroupInventory -Server $Server -SearchBase $SearchBase -Credential $Credential)
    $privileged = Get-ADAuditPrivilegedMembership -Groups $groupInventory -Server $Server -SearchBase $SearchBase -Credential $Credential
    Write-Host ("[+] {0} groups, {1} privileged groups, {2} distinct privileged principals" -f $groupInventory.Count, @($privileged.Groups).Count, $privileged.MapByMember.Count)
}

foreach ($s in $adScanners) {
    Write-Host "[*] Running $s..."
    try {
        $out = switch ($s) {
            'DomainPolicy' { Invoke-ADAuditDomainPolicyScan -Server $Server -Credential $Credential -Privileged $privileged }
            'Accounts' { Invoke-ADAuditAccountScan -Privileged $privileged -Server $Server -SearchBase $SearchBase -Credential $Credential -ActiveDays $ActiveDays -PasswordAgeDays $PasswordAgeDays -MaxGroupMemberships $MaxGroupMemberships -ServiceAccountPattern $ServiceAccountPattern }
            'Groups' { Invoke-ADAuditGroupScan -Groups $groupInventory -Privileged $privileged -MaxNestingDepth $MaxNestingDepth -MaxDomainAdmins $MaxDomainAdmins -Server $Server -SearchBase $SearchBase -Credential $Credential }
            'OSInventory' { Invoke-ADAuditOSInventory -Computers $adScope }
            'LapsBitLocker' { Invoke-ADAuditLapsBitLocker -Computers $adScope -Server $Server -SearchBase $SearchBase -Credential $Credential }
            'DomainControllers' { Invoke-ADAuditDomainControllerScan -Computers $allComputers -Server $Server -Credential $Credential }
            'AuditPolicy' { Invoke-ADAuditAuditPolicyScan -Server $Server -Credential $Credential }
            'Permissions' { Invoke-ADAuditPermissionScan -Privileged $privileged -Server $Server -Credential $Credential -SkipSysvol:$SkipSysvol }
        }
        foreach ($o in $out) { [void]$results.Add($o) }
    }
    catch { [void]$results.Add((New-ADAuditResult -Scanner $s -Computer '(domain)' -Severity 'Error' -Finding $_.Exception.Message)) }
}

# ---------- DC Security log ----------
if ($Scanners -contains 'Events') {
    $dcTargets = @($allComputers | Where-Object { $_.IsDomainController -and -not $_.IsStale })
    if ($ComputerName) { $dcTargets = @($dcTargets | Where-Object { $ComputerName -contains $_.Name -or $ComputerName -contains $_.DnsHostName }) }
    $privSids = @{}; $privNames = @{}
    if ($privileged) {
        foreach ($g in $privileged.Groups) { if ($g.Sid) { $privSids[$g.Sid] = $g.Label } }
        foreach ($m in $privileged.Members) { if ($m.MemberName) { $privNames[$m.MemberName] = $true } }
    }
    $domainDn = $null
    try { $domainDn = Get-ADAuditDefaultNamingContext -Server $Server -Credential $Credential } catch { }
    Write-Host ("[*] Reading Security logs on {0} DCs (last {1} days)..." -f $dcTargets.Count, $EventDays)
    foreach ($dc in $dcTargets) {
        try {
            foreach ($o in (Invoke-ADAuditEventScan -ComputerName $dc.DnsHostName -EventDays $EventDays -MaxEvents $EventMaxPerDC -PrivilegedSids $privSids -PrivilegedNames $privNames -DomainDN $domainDn -TimeoutMs $NetworkTimeoutMs)) { [void]$results.Add($o) }
        }
        catch { [void]$results.Add((New-ADAuditResult -Scanner 'Events' -Target $dc.DnsHostName -Severity 'Error' -Finding $_.Exception.Message)) }
    }
}

# ---------- Per-host scanners ----------
function Invoke-ADAuditHostScan {
    param([string]$ComputerName, [bool]$IsDomainController, [string[]]$Scanners, [int]$TimeoutMs, [bool]$SkipSmb1)
    if (-not (Test-ADAuditTcpPort -ComputerName $ComputerName -Port 445 -TimeoutMs $TimeoutMs)) {
        New-ADAuditResult -Scanner 'Reachability' -Computer $ComputerName -Severity 'Info' -Finding 'TCP 445 not reachable; host scanners skipped'
        return
    }
    foreach ($s in $Scanners) {
        try {
            switch ($s) {
                'Spooler' { Invoke-ADAuditSpoolerScan -ComputerName $ComputerName -IsDomainController $IsDomainController }
                'Smb' { Invoke-ADAuditSmbScan -ComputerName $ComputerName -IsDomainController $IsDomainController -TimeoutMs $TimeoutMs -SkipSmb1:$SkipSmb1 }
                'LocalAdmin' { Invoke-ADAuditLocalAdminScan -ComputerName $ComputerName }
                'Share' { Invoke-ADAuditShareScan -ComputerName $ComputerName -IsDomainController $IsDomainController }
            }
        }
        catch { New-ADAuditResult -Scanner $s -Computer $ComputerName -Severity 'Error' -Finding $_.Exception.Message }
    }
}

if ($hostScanners.Count -gt 0) {
    if ($ComputerName) {
        $targets = foreach ($n in $ComputerName) {
            $match = $allComputers | Where-Object { $_.Name -ieq $n -or $_.DnsHostName -ieq $n } | Select-Object -First 1
            if ($match) { $match } else { [pscustomobject]@{ Name = $n; DnsHostName = $n; IsDomainController = $false } }
        }
    }
    else { $targets = $allComputers | Where-Object { -not $_.IsStale } }
    if ($DomainControllersOnly) { $targets = $targets | Where-Object { $_.IsDomainController } }
    $targets = @($targets)

    Write-Host ("[*] Running host scanners ({0}) on {1} hosts, {2} at a time..." -f ($hostScanners -join ', '), $targets.Count, $Throttle)

    $iss = [System.Management.Automation.Runspaces.InitialSessionState]::CreateDefault()
    foreach ($f in (Get-ChildItem function: | Where-Object { $_.Name -like '*-ADAudit*' })) {
        $iss.Commands.Add((New-Object System.Management.Automation.Runspaces.SessionStateFunctionEntry -ArgumentList $f.Name, $f.Definition))
    }
    # Extra headroom so a hung/stopped job can't starve the pool
    $pool = [runspacefactory]::CreateRunspacePool(1, $Throttle * 2, $iss, $Host)
    $pool.Open()

    $queue = New-Object System.Collections.Queue
    foreach ($t in $targets) { $queue.Enqueue($t) }
    $active = New-Object System.Collections.ArrayList
    $done = 0; $total = $targets.Count

    try {
        while ($queue.Count -gt 0 -or $active.Count -gt 0) {
            while ($queue.Count -gt 0 -and $active.Count -lt $Throttle) {
                $t = $queue.Dequeue()
                $ps = [powershell]::Create()
                $ps.RunspacePool = $pool
                [void]$ps.AddCommand('Invoke-ADAuditHostScan').
                    AddParameter('ComputerName', $t.DnsHostName).
                    AddParameter('IsDomainController', [bool]$t.IsDomainController).
                    AddParameter('Scanners', $hostScanners).
                    AddParameter('TimeoutMs', $NetworkTimeoutMs).
                    AddParameter('SkipSmb1', [bool]$SkipSmb1)
                [void]$active.Add([pscustomobject]@{ Target = $t; PS = $ps; Handle = $ps.BeginInvoke(); Started = [DateTime]::UtcNow })
            }

            foreach ($j in @($active)) {
                if ($j.Handle.IsCompleted) {
                    try {
                        foreach ($o in $j.PS.EndInvoke($j.Handle)) { [void]$results.Add($o) }
                        foreach ($e in $j.PS.Streams.Error) {
                            [void]$results.Add((New-ADAuditResult -Scanner 'Runner' -Computer $j.Target.DnsHostName -Severity 'Error' -Finding $e.ToString()))
                        }
                    }
                    catch { [void]$results.Add((New-ADAuditResult -Scanner 'Runner' -Computer $j.Target.DnsHostName -Severity 'Error' -Finding $_.Exception.Message)) }
                    finally { $j.PS.Dispose() }
                    $active.Remove($j); $done++
                }
                elseif (([DateTime]::UtcNow - $j.Started).TotalSeconds -gt $TimeoutSeconds) {
                    [void]$j.PS.BeginStop($null, $null)
                    [void]$results.Add((New-ADAuditResult -Scanner 'Runner' -Computer $j.Target.DnsHostName -Severity 'Error' -Finding "Timed out after $TimeoutSeconds s"))
                    $active.Remove($j); $done++
                }
            }

            if ($total -gt 0) {
                Write-Progress -Activity 'AD audit host scanners' -Status "$done / $total hosts" -PercentComplete ([int](100 * $done / $total))
            }
            Start-Sleep -Milliseconds 200
        }
    }
    finally {
        Write-Progress -Activity 'AD audit host scanners' -Completed
        $pool.Close()
        $pool.Dispose()
    }
}

# ---------- Output ----------
New-Item -ItemType Directory -Path $OutputPath -Force | Out-Null

function ConvertTo-ADAuditFlatRow {
    param([object[]]$Rows)
    $cols = New-Object System.Collections.Generic.List[string]
    foreach ($r in $Rows) { foreach ($p in $r.PSObject.Properties.Name) { if (-not $cols.Contains($p)) { $cols.Add($p) } } }
    foreach ($r in $Rows) {
        $o = [ordered]@{}
        foreach ($c in $cols) {
            $v = $r.$c
            if ($v -is [array]) { $v = ($v -join '; ') }
            elseif ($v -is [DateTime]) { $v = $v.ToString('yyyy-MM-dd HH:mm:ss') }
            $o[$c] = $v
        }
        [pscustomobject]$o
    }
}

$all = @($results)
$flat = New-Object System.Collections.ArrayList
foreach ($g in ($all | Group-Object Scanner)) {
    $rows = @(ConvertTo-ADAuditFlatRow -Rows $g.Group)
    $rows | Export-Csv -Path (Join-Path $OutputPath "$($g.Name).csv") -NoTypeInformation -Encoding UTF8
    foreach ($r in $rows) { [void]$flat.Add($r) }
}

$sevOrder = 'High', 'Medium', 'Low', 'Info', 'Error', 'OK'
$findings = @(Get-ADAuditEnrichedFinding -Rows @($flat) | Sort-Object @{ Expression = { $sevOrder.IndexOf([string]$_.Severity) } }, Category, Rule, Target)
$findings | Export-Csv -Path (Join-Path $OutputPath 'AllFindings.csv') -NoTypeInformation -Encoding UTF8
$score = Get-ADAuditScore -Findings $findings

# results.json (machine-readable; also the input for a later -Baseline)
$domainName = $null
try { $domainName = ConvertTo-ADAuditDnsName (Get-ADAuditDefaultNamingContext -Server $Server -Credential $Credential) } catch { }
$meta = [ordered]@{
    Tool        = 'dtecht-AD'
    Version     = '1.2.0'
    Generated   = $started.ToString('yyyy-MM-ddTHH:mm:sszzz')
    DurationSec = [int]((Get-Date) - $started).TotalSeconds
    Domain      = $domainName
    RunAs       = "$env:USERDOMAIN\$env:USERNAME"
    Host        = $env:COMPUTERNAME
    Scanners    = @($Scanners)
    Score       = [ordered]@{ Overall = $score.Overall; Categories = @($score.Categories) }
    Parameters  = [ordered]@{ ActiveDays = $ActiveDays; PasswordAgeDays = $PasswordAgeDays; MaxGroupMemberships = $MaxGroupMemberships; MaxNestingDepth = $MaxNestingDepth; EventDays = $EventDays; DomainControllersOnly = [bool]$DomainControllersOnly; ComputerName = @($ComputerName) }
}
[ordered]@{ Meta = $meta; Results = @($flat) } | ConvertTo-Json -Depth 6 | Out-File -FilePath (Join-Path $OutputPath 'results.json') -Encoding UTF8

# Changes since baseline
$changes = @()
if ($baselineRun) {
    $changes = @(Compare-ADAuditRun -Previous @($baselineRun.Results) -Current @($flat) -PreviousScanners @($baselineRun.Meta.Scanners) -CurrentScanners $Scanners)
    $changes | Export-Csv -Path (Join-Path $OutputPath 'Changes.csv') -NoTypeInformation -Encoding UTF8
}

# Summary HTML
$matrix = foreach ($g in ($all | Group-Object Scanner | Sort-Object Name)) {
    $row = [ordered]@{ Scanner = $g.Name }
    foreach ($s in $sevOrder) { $row[$s] = @($g.Group | Where-Object { $_.Severity -eq $s }).Count }
    [pscustomobject]$row
}
$top = @($findings | Where-Object { $_.Severity -in 'High', 'Medium' -and $_.Scanner -ne 'Events' } | Select-Object Severity, Category, Rule, Target, Finding)
$recent = @($findings | Where-Object { $_.Scanner -eq 'Events' -and $_.Severity -in 'High', 'Medium' } | Select-Object Severity, Target, Finding)

$css = @'
<style>
body { font-family: Segoe UI, Arial, sans-serif; margin: 24px; color: #1b1f24; }
h1 { font-size: 22px; } h2 { font-size: 17px; margin-top: 28px; }
table { border-collapse: collapse; font-size: 13px; }
th, td { border: 1px solid #d0d7de; padding: 4px 10px; text-align: left; }
th { background: #f3f5f7; }
.meta { color: #57606a; font-size: 13px; }
.score { font-size: 34px; font-weight: 600; margin: 4px 0 2px; }
.note { color: #57606a; font-size: 12px; }
</style>
'@
$metaHtml = "<p class='meta'>Generated $(Get-Date -Format 'yyyy-MM-dd HH:mm') by $env:USERDOMAIN\$env:USERNAME on $env:COMPUTERNAME &middot; Scanners: $($Scanners -join ', ')</p>"
$changesHtml = ''
if ($baselineRun) {
    $chSorted = $changes | Sort-Object @{ Expression = { $sevOrder.IndexOf($_.Severity) } }, Change, Scanner, Target
    $changesHtml = "<h2>Changes since baseline $($baselineRun.Meta.Generated) ($(@($changes).Count))</h2>" +
        $(if ($chSorted) { ($chSorted | ConvertTo-Html -Fragment) } else { '<p>No changes.</p>' })
}
$scoreHtml = "<h2>Risk score</h2><div class='score'>$($score.Overall) / 100</div><p class='note'>Lower is better. Each triggered rule adds High 15 / Medium 8 / Low 3 points to its category (max 100); the overall score is the worst category. Events and Info findings are not scored.</p>" +
    ($score.Categories | ConvertTo-Html -Fragment) +
    "<h2>Rules triggered ($(@($score.Rules).Count))</h2>" +
    $(if ($score.Rules) { ($score.Rules | Select-Object Severity, Category, Rule, Objects, Remediation | ConvertTo-Html -Fragment) } else { '<p>None.</p>' })
$body = "<h1>AD Audit Summary</h1>$metaHtml" + $scoreHtml + $changesHtml +
    "<h2>High and Medium findings ($(@($top).Count))</h2>" +
    $(if ($top) { ($top | ConvertTo-Html -Fragment) } else { '<p>None.</p>' }) +
    $(if ($Scanners -contains 'Events') { "<h2>Recent High/Medium changes on DCs ($(@($recent).Count))</h2>" + $(if ($recent) { ($recent | ConvertTo-Html -Fragment) } else { '<p>None.</p>' }) } else { '' }) +
    "<h2>Results by scanner</h2>" + ($matrix | ConvertTo-Html -Fragment)
ConvertTo-Html -Title 'AD Audit Summary' -Head $css -Body $body | Out-File -FilePath (Join-Path $OutputPath 'Summary.html') -Encoding UTF8

Write-Host ""
$matrix | Format-Table -AutoSize | Out-Host
Write-Host ("[+] Risk score: {0}/100 (lower is better)" -f $score.Overall)
$score.Categories | Format-Table -AutoSize | Out-Host
if ($baselineRun) {
    Write-Host ("[+] Changes since baseline: {0} ({1} New, {2} Resolved, {3} Added to privileged groups, {4} Removed, {5} policy changes)" -f @($changes).Count,
        @($changes | Where-Object Change -eq 'New').Count, @($changes | Where-Object Change -eq 'Resolved').Count,
        @($changes | Where-Object Change -eq 'Added').Count, @($changes | Where-Object Change -eq 'Removed').Count, @($changes | Where-Object Change -eq 'Changed').Count)
}
Write-Host "[+] Results written to $OutputPath"
if ($OpenReport) { Invoke-Item -LiteralPath (Join-Path $OutputPath 'Summary.html') }
}
#endregion runner

Set-Alias -Name 'dtecht-ad' -Value 'Invoke-DtechtAD'
Export-ModuleMember -Function 'Invoke-DtechtAD' -Alias 'dtecht-ad'
